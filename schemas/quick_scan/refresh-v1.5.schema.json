          "pattern": "Z$"
        },
        "source_query": {
          "oneOf": [
            {
              "$ref": "urn:iqs:quick-scan:query:2#/$defs/Request"
            },
            {
              "$ref": "urn:iqs:quick-scan:query:2.6#/$defs/Request"
            }
          ]
        },
        "subject_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:iqs:quick-scan:query:2#/$defs/SubjectRef"
          },
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true
        },
        "field_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "minItems": 1,
          "maxItems": 200,
          "uniqueItems": true
        },
        "origin_task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "cohort_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
        },
        "question_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 1,
          "maxItems": 30,
          "uniqueItems": true
        },
        "execution_profile_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "protocol",
        "operation",
        "request_id",
        "consumer_id",
        "requested_at",
        "source_query",
        "subject_refs",
        "field_ids",
        "origin_task_id",
        "reason",
        "cohort_id",
        "question_ids",
        "execution_profile_sha256"
      ],
      "additionalProperties": false
    },
    "RetainedBudgetAttempt": {
      "type": "object",
      "properties": {
        "budget_attempt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "policy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "route_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
