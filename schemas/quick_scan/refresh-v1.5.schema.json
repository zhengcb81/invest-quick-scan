            "null"
          ]
        },
        "reconciled_at": {
          "type": "null"
        },
        "native": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "budget_only",
                "native_single",
                "native_pack"
              ]
            },
            "members": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "work_item_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "entity_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "question_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "scope": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "scope_id": {
                    "type": "string",
                    "minLength": 1,
