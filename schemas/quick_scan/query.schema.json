{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iqs:quick-scan:query:1",
  "title": "QuickScanQueryContract",
  "description": "只读查询、固定候选快照、受控刷新预览/确认、候选提名和研究线索接口。",
  "$defs": {
    "Sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "EntityId":{"type":"string","pattern":"^ENT_[A-Za-z0-9_]+$"},
    "ObservationId":{"type":"string","pattern":"^obs_[a-f0-9]{64}$"},
    "Coverage":{
      "type":"object",
      "properties":{
        "status":{"enum":["complete","partial","not_covered","unknown"]},
        "requested_markets":{"type":"array","uniqueItems":true,"items":{"enum":["CN","HK","US"]}},
        "covered_markets":{"type":"array","uniqueItems":true,"items":{"enum":["CN","HK","US"]}},
        "requested_field_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":160}},
        "covered_field_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":160}},
        "missing_field_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":160}},
        "scores_available":{"type":"boolean"},
        "facts_available":{"type":"boolean"},
        "reason":{"type":["string","null"],"maxLength":350}
      },
      "required":["status","requested_markets","covered_markets","requested_field_ids","covered_field_ids","missing_field_ids","scores_available","facts_available","reason"],
      "additionalProperties":false
    },
    "Watermark":{
      "type":"object",
      "properties":{
        "store_id":{"type":"string","minLength":1,"maxLength":160},
        "snapshot_id":{"type":"string","minLength":1,"maxLength":160},
        "member_sequence":{"type":"integer","minimum":0},
        "observation_sequence":{"type":"integer","minimum":0},
        "ack_sequence":{"type":"integer","minimum":0},
        "read_at":{"type":"string","format":"date-time"}
      },
      "required":["store_id","snapshot_id","member_sequence","observation_sequence","ack_sequence","read_at"],
      "additionalProperties":false
    },
    "ScoreRef":{
      "type":"object",
      "properties":{
        "field_id":{"type":"string","minLength":1,"maxLength":160},
        "status":{"enum":["scored","unknown","insufficient_evidence","not_applicable","error","stale","not_collected"]},
        "score":{"type":["integer","null"],"minimum":1,"maximum":10},
        "information_as_of":{"type":["string","null"],"format":"date"},
        "observed_at":{"type":["string","null"],"format":"date-time"},
        "observation_id":{"anyOf":[{"$ref":"#/$defs/ObservationId"},{"type":"null"}]},
        "model_resolved":{"type":["string","null"],"maxLength":160},
        "check_level":{"enum":["unverified_model_output","execution_verified","screening_audited","formal_research_accepted",null]}
      },
      "required":["field_id","status","score","information_as_of","observed_at","observation_id","model_resolved","check_level"],
      "allOf":[{"if":{"properties":{"status":{"const":"scored"}},"required":["status"]},"then":{"properties":{"score":{"type":"integer","minimum":1,"maximum":10},"information_as_of":{"type":"string","format":"date"},"observed_at":{"type":"string","format":"date-time"},"observation_id":{"$ref":"#/$defs/ObservationId"},"model_resolved":{"type":"string","minLength":1,"maxLength":160},"check_level":{"enum":["unverified_model_output","execution_verified","screening_audited","formal_research_accepted"]}}}},{"if":{"properties":{"status":{"enum":["unknown","insufficient_evidence","not_applicable","error","stale","not_collected"]}},"required":["status"]},"then":{"properties":{"score":{"type":"null"}}}}],
      "additionalProperties":false
    },
    "SecuritySummary":{
      "type":"object",
      "properties":{
        "security_id":{"type":"string","minLength":1,"maxLength":120},
        "market":{"enum":["CN","HK","US"]},
        "exchange":{"type":"string","minLength":1,"maxLength":60},
        "ticker":{"type":"string","minLength":1,"maxLength":40},
        "listing_status":{"enum":["active","suspended","delisted","unknown"]}
      },
      "required":["security_id","market","exchange","ticker","listing_status"],
      "additionalProperties":false
    },
    "CompanySummary":{
      "type":"object",
      "properties":{
        "entity_id":{"$ref":"#/$defs/EntityId"},
        "canonical_name":{"type":"string","minLength":1,"maxLength":200},
        "aliases":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":120},"maxItems":30},
        "securities":{"type":"array","items":{"$ref":"#/$defs/SecuritySummary"},"maxItems":30},
        "company_type":{"type":["string","null"],"maxLength":100},
        "industries":{"type":"array","items":{"type":"string","minLength":1,"maxLength":100},"maxItems":8},
        "stage":{"type":["string","null"],"maxLength":100},
        "score_refs":{"type":"array","items":{"$ref":"#/$defs/ScoreRef"},"maxItems":300},
        "recovery_watch_status":{"enum":["watch","not_flagged","unknown"]},
        "facts_available":{"type":"boolean"},
        "last_observed_at":{"type":["string","null"],"format":"date-time"}
      },
      "required":["entity_id","canonical_name","aliases","securities","company_type","industries","stage","score_refs","recovery_watch_status","facts_available","last_observed_at"],
      "additionalProperties":false
    },
    "CapabilitiesPayload":{"type":"object","properties":{"required_capabilities":{"type":"array","uniqueItems":true,"items":{"enum":["scores","facts","history","recovery_watch","candidate_sets","refresh_preview"]}},"markets":{"type":"array","uniqueItems":true,"items":{"enum":["CN","HK","US"]}}},"required":["required_capabilities","markets"],"additionalProperties":false},
    "SearchPayload":{
      "type":"object",
      "properties":{
        "filters":{
          "type":"object",
          "properties":{
            "query_text":{"type":"string","maxLength":200},
            "markets":{"type":"array","uniqueItems":true,"items":{"enum":["CN","HK","US"]}},
            "company_types":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":100}},
            "industries":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":100}},
            "stages":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":100}},
            "score_logic":{"enum":["all","any"]},
            "score_conditions":{"type":"array","items":{"type":"object","properties":{"field_id":{"type":"string","minLength":1,"maxLength":160},"operator":{"enum":["eq","gt","gte","lt","lte"]},"value":{"type":"integer","minimum":1,"maximum":10}},"required":["field_id","operator","value"],"additionalProperties":false},"maxItems":100},
            "recovery_watch_status":{"enum":["watch","not_flagged","unknown"]},
            "facts_available":{"type":"boolean"}
          },
          "additionalProperties":false
        },
        "page_size":{"type":"integer","minimum":1,"maximum":100},
        "snapshot_id":{"type":["string","null"],"maxLength":160},
        "cursor":{"type":["string","null"],"maxLength":2048},
        "sort":{"type":"object","properties":{"field":{"enum":["canonical_name","last_observed_at","score"]},"field_id":{"type":["string","null"],"maxLength":160},"direction":{"enum":["asc","desc"]}},"required":["field","field_id","direction"],"additionalProperties":false}
      },
      "required":["filters","page_size","snapshot_id","cursor","sort"],
      "additionalProperties":false
    },
    "GetProfilesPayload":{"type":"object","properties":{"entity_ids":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/EntityId"},"minItems":1,"maxItems":100},"field_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":160},"maxItems":300},"snapshot_id":{"type":["string","null"],"maxLength":160},"include_history":{"type":"boolean"}},"required":["entity_ids","field_ids","snapshot_id","include_history"],"additionalProperties":false},
    "CandidateSetPayload":{"type":"object","properties":{"snapshot_id":{"type":"string","minLength":1,"maxLength":160},"query_hash":{"$ref":"#/$defs/Sha256"},"entity_ids":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/EntityId"},"minItems":1,"maxItems":500},"observation_ids":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/ObservationId"},"maxItems":3000},"rule_id":{"type":"string","minLength":1,"maxLength":120},"rule_version":{"type":"string","minLength":1,"maxLength":80},"label":{"type":"string","minLength":1,"maxLength":200}},"required":["snapshot_id","query_hash","entity_ids","observation_ids","rule_id","rule_version","label"],"additionalProperties":false},
    "RefreshPayload":{"type":"object","properties":{"snapshot_id":{"type":"string","minLength":1,"maxLength":160},"entity_ids":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/EntityId"},"minItems":1,"maxItems":100},"field_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":160},"minItems":1,"maxItems":200},"consumer_task_id":{"type":"string","minLength":1,"maxLength":160},"reason":{"type":"string","minLength":1,"maxLength":500}},"required":["snapshot_id","entity_ids","field_ids","consumer_task_id","reason"],"additionalProperties":false},
    "ApproveRefreshPayload":{"type":"object","properties":{"preview_id":{"type":"string","minLength":1,"maxLength":160},"confirmation_id":{"type":"string","minLength":8,"maxLength":200},"idempotency_key":{"type":"string","minLength":8,"maxLength":200}},"required":["preview_id","confirmation_id","idempotency_key"],"additionalProperties":false},
    "NominatePayload":{"type":"object","properties":{"nomination_id":{"type":"string","minLength":1,"maxLength":160},"origin_task_id":{"type":"string","minLength":1,"maxLength":160},"candidate":{"type":"object","properties":{"canonical_name":{"type":"string","minLength":1,"maxLength":200},"market":{"enum":["CN","HK","US"]},"exchange":{"type":"string","minLength":1,"maxLength":60},"ticker":{"type":"string","minLength":1,"maxLength":40},"security_type":{"type":"string","minLength":1,"maxLength":80}},"required":["canonical_name","market","exchange","ticker","security_type"],"additionalProperties":false},"observation_ids":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/ObservationId"},"maxItems":100},"reason":{"type":"string","minLength":1,"maxLength":500}},"required":["nomination_id","origin_task_id","candidate","observation_ids","reason"],"additionalProperties":false},
    "ConflictPayload":{"type":"object","properties":{"conflict_id":{"type":"string","minLength":1,"maxLength":160},"entity_ids":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/EntityId"},"minItems":2,"maxItems":10},"conflict_type":{"enum":["possible_duplicate","wrong_security_link","parent_subsidiary","segment_scope","listing_status","other"]},"reason":{"type":"string","minLength":1,"maxLength":500},"observation_ids":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/ObservationId"},"maxItems":100}},"required":["conflict_id","entity_ids","conflict_type","reason","observation_ids"],"additionalProperties":false},
    "ResearchContextPayload":{"type":"object","properties":{"origin_task_id":{"type":"string","minLength":1,"maxLength":160},"entity_ids":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/EntityId"},"minItems":1,"maxItems":100},"observation_ids":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/ObservationId"},"maxItems":3000},"purpose":{"type":"string","minLength":1,"maxLength":500}},"required":["origin_task_id","entity_ids","observation_ids","purpose"],"additionalProperties":false},
    "Request":{
      "type":"object",
      "properties":{
        "message_type":{"const":"request"},
        "schema_version":{"const":"1.0.0"},
        "request_id":{"type":"string","minLength":1,"maxLength":160},
        "consumer_id":{"enum":["user_ui","analyze-theme-value-chain","industry-research","invest-quick-scan"]},
        "operation":{"enum":["capabilities","search","get_profiles","candidate_set","request_refresh","approve_refresh","nominate","report_conflict","research_context"]},
        "requested_at":{"type":"string","format":"date-time"},
        "payload":{"type":"object"}
      },
      "required":["message_type","schema_version","request_id","consumer_id","operation","requested_at","payload"],
      "allOf":[
        {"if":{"properties":{"operation":{"const":"capabilities"}},"required":["operation"]},"then":{"properties":{"payload":{"$ref":"#/$defs/CapabilitiesPayload"}}}},
        {"if":{"properties":{"operation":{"const":"search"}},"required":["operation"]},"then":{"properties":{"payload":{"$ref":"#/$defs/SearchPayload"}}}},
        {"if":{"properties":{"payload":{"properties":{"cursor":{"type":"string"}},"required":["cursor"]}},"required":["payload"]},"then":{"properties":{"payload":{"properties":{"snapshot_id":{"type":"string","minLength":1}}}}}},
        {"if":{"properties":{"operation":{"const":"get_profiles"}},"required":["operation"]},"then":{"properties":{"payload":{"$ref":"#/$defs/GetProfilesPayload"}}}},
        {"if":{"properties":{"operation":{"const":"candidate_set"}},"required":["operation"]},"then":{"properties":{"payload":{"$ref":"#/$defs/CandidateSetPayload"}}}},
        {"if":{"properties":{"operation":{"const":"request_refresh"}},"required":["operation"]},"then":{"properties":{"payload":{"$ref":"#/$defs/RefreshPayload"}}}},
        {"if":{"properties":{"operation":{"const":"approve_refresh"}},"required":["operation"]},"then":{"properties":{"payload":{"$ref":"#/$defs/ApproveRefreshPayload"}}}},
        {"if":{"properties":{"operation":{"const":"nominate"}},"required":["operation"]},"then":{"properties":{"payload":{"$ref":"#/$defs/NominatePayload"}}}},
        {"if":{"properties":{"operation":{"const":"report_conflict"}},"required":["operation"]},"then":{"properties":{"payload":{"$ref":"#/$defs/ConflictPayload"}}}},
        {"if":{"properties":{"operation":{"const":"research_context"}},"required":["operation"]},"then":{"properties":{"payload":{"$ref":"#/$defs/ResearchContextPayload"}}}}
      ],
      "additionalProperties":false
    },
    "CoverageResult":{
      "type":"object",
      "properties":{"coverage":{"$ref":"#/$defs/Coverage"},"watermark":{"$ref":"#/$defs/Watermark"}},
      "required":["coverage","watermark"],
      "additionalProperties":false
    },
    "CapabilityResult":{
      "type":"object",
      "properties":{"supported_operations":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"supported_capabilities":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"contract_versions":{"type":"object","additionalProperties":{"type":"string"}},"coverage":{"$ref":"#/$defs/Coverage"},"watermark":{"$ref":"#/$defs/Watermark"}},
      "required":["supported_operations","supported_capabilities","contract_versions","coverage","watermark"],
      "additionalProperties":false
    },
    "SearchResult":{
      "type":"object",
      "properties":{
        "status":{"enum":["ok","empty","partial","coverage_gap","capability_unavailable","snapshot_expired"]},
        "query_hash":{"$ref":"#/$defs/Sha256"},
        "snapshot_id":{"type":"string","minLength":1,"maxLength":160},
        "page_size":{"type":"integer","minimum":1,"maximum":100},
        "next_cursor":{"type":["string","null"],"maxLength":2048},
        "items":{"type":"array","items":{"$ref":"#/$defs/CompanySummary"},"maxItems":100},
        "coverage":{"$ref":"#/$defs/Coverage"},
        "watermark":{"$ref":"#/$defs/Watermark"}
      },
      "required":["status","query_hash","snapshot_id","page_size","next_cursor","items","coverage","watermark"],
      "allOf":[
        {"if":{"properties":{"status":{"const":"ok"}},"required":["status"]},"then":{"properties":{"items":{"minItems":1},"coverage":{"properties":{"status":{"const":"complete"},"missing_field_ids":{"maxItems":0}}}}}},
        {"if":{"properties":{"status":{"const":"empty"}},"required":["status"]},"then":{"properties":{"items":{"maxItems":0},"coverage":{"properties":{"status":{"const":"complete"},"missing_field_ids":{"maxItems":0}}}}}},
        {"if":{"properties":{"status":{"const":"partial"}},"required":["status"]},"then":{"properties":{"coverage":{"properties":{"status":{"const":"partial"}}}}}},
        {"if":{"properties":{"status":{"const":"coverage_gap"}},"required":["status"]},"then":{"properties":{"coverage":{"properties":{"status":{"enum":["partial","not_covered","unknown"]}}}}}}
      ],
      "additionalProperties":false
    },
    "ProfileResult":{
      "type":"object",
      "properties":{"status":{"enum":["ok","partial","coverage_gap"]},"profiles":{"type":"array","items":{"type":"object","properties":{"entity_id":{"$ref":"#/$defs/EntityId"},"canonical_name":{"type":"string","minLength":1,"maxLength":200},"security_ids":{"type":"array","items":{"type":"string","minLength":1,"maxLength":120},"uniqueItems":true,"maxItems":30},"observations":{"type":"array","items":{"$ref":"urn:iqs:observation:1"},"maxItems":2000}},"required":["entity_id","canonical_name","security_ids","observations"],"additionalProperties":false},"maxItems":100},"missing_entity_ids":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/EntityId"},"maxItems":100},"coverage":{"$ref":"#/$defs/Coverage"},"watermark":{"$ref":"#/$defs/Watermark"}},"required":["status","profiles","missing_entity_ids","coverage","watermark"],"additionalProperties":false
    },
    "CandidateSetResult":{"type":"object","properties":{"candidate_set_id":{"type":"string","minLength":1,"maxLength":160},"candidate_set_sha256":{"$ref":"#/$defs/Sha256"},"snapshot_id":{"type":"string","minLength":1,"maxLength":160},"rule_id":{"type":"string","minLength":1,"maxLength":120},"rule_version":{"type":"string","minLength":1,"maxLength":80},"created_at":{"type":"string","format":"date-time"},"immutable":{"const":true},"members":{"type":"array","items":{"type":"object","properties":{"entity_id":{"$ref":"#/$defs/EntityId"},"observation_ids":{"type":"array","items":{"$ref":"#/$defs/ObservationId"},"uniqueItems":true,"maxItems":1000}},"required":["entity_id","observation_ids"],"additionalProperties":false},"maxItems":500}},"required":["candidate_set_id","candidate_set_sha256","snapshot_id","rule_id","rule_version","created_at","immutable","members"],"additionalProperties":false},
    "RefreshPreviewResult":{"type":"object","properties":{"preview_id":{"type":"string","minLength":1,"maxLength":160},"status":{"enum":["preview_ready","no_gap","out_of_scope","coverage_gap","budget_unavailable"]},"scope_sha256":{"$ref":"#/$defs/Sha256"},"policy_version":{"type":["string","null"],"maxLength":160},"estimated_max_cost":{"type":["number","null"],"minimum":0},"reused_field_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":160}},"eligible_field_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":160}},"rejected_scope":{"type":"array","items":{"type":"string","minLength":1,"maxLength":240}},"requires_user_confirmation":{"type":"boolean"},"dispatch_started":{"const":false}},"required":["preview_id","status","scope_sha256","policy_version","estimated_max_cost","reused_field_ids","eligible_field_ids","rejected_scope","requires_user_confirmation","dispatch_started"],"additionalProperties":false},
    "RefreshAcceptedResult":{"type":"object","properties":{"refresh_request_id":{"type":"string","minLength":1,"maxLength":160},"status":{"enum":["accepted","already_submitted","rejected"]},"scope_sha256":{"$ref":"#/$defs/Sha256"},"policy_version":{"type":"string","minLength":1,"maxLength":160},"dispatch_started":{"const":false},"idempotency_key":{"type":"string","minLength":8,"maxLength":200},"error_code":{"type":["string","null"],"enum":[null,"invalid_confirmation","scope_changed","budget_changed","duplicate_request"]}},"required":["refresh_request_id","status","scope_sha256","policy_version","dispatch_started","idempotency_key","error_code"],"additionalProperties":false},
    "NominationResult":{"type":"object","properties":{"nomination_id":{"type":"string","minLength":1,"maxLength":160},"status":{"enum":["pending_identity_review","duplicate_candidate","rejected"]},"candidate_id":{"type":["string","null"],"maxLength":160},"auto_admitted":{"const":false}},"required":["nomination_id","status","candidate_id","auto_admitted"],"additionalProperties":false},
    "ConflictResult":{"type":"object","properties":{"conflict_id":{"type":"string","minLength":1,"maxLength":160},"status":{"enum":["recorded_for_review","duplicate_feedback","rejected"]},"entity_ids":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/EntityId"},"minItems":2,"maxItems":10},"identity_changed":{"const":false}},"required":["conflict_id","status","entity_ids","identity_changed"],"additionalProperties":false},
    "ResearchContextResult":{"type":"object","properties":{"leads":{"type":"array","items":{"$ref":"urn:iqs:quick-scan:exchange:1#/$defs/ResearchLead"},"maxItems":100},"coverage":{"$ref":"#/$defs/Coverage"},"watermark":{"$ref":"#/$defs/Watermark"}},"required":["leads","coverage","watermark"],"additionalProperties":false},
    "Response":{
      "type":"object",
      "properties":{"message_type":{"const":"response"},"schema_version":{"const":"1.0.0"},"request_id":{"type":"string","minLength":1,"maxLength":160},"operation":{"enum":["capabilities","search","get_profiles","candidate_set","request_refresh","approve_refresh","nominate","report_conflict","research_context"]},"response_at":{"type":"string","format":"date-time"},"result":{"type":"object"}},
      "required":["message_type","schema_version","request_id","operation","response_at","result"],
      "allOf":[
        {"if":{"properties":{"operation":{"const":"capabilities"}},"required":["operation"]},"then":{"properties":{"result":{"$ref":"#/$defs/CapabilityResult"}}}},
        {"if":{"properties":{"operation":{"const":"search"}},"required":["operation"]},"then":{"properties":{"result":{"$ref":"#/$defs/SearchResult"}}}},
        {"if":{"properties":{"operation":{"const":"get_profiles"}},"required":["operation"]},"then":{"properties":{"result":{"$ref":"#/$defs/ProfileResult"}}}},
        {"if":{"properties":{"operation":{"const":"candidate_set"}},"required":["operation"]},"then":{"properties":{"result":{"$ref":"#/$defs/CandidateSetResult"}}}},
        {"if":{"properties":{"operation":{"const":"request_refresh"}},"required":["operation"]},"then":{"properties":{"result":{"$ref":"#/$defs/RefreshPreviewResult"}}}},
        {"if":{"properties":{"operation":{"const":"approve_refresh"}},"required":["operation"]},"then":{"properties":{"result":{"$ref":"#/$defs/RefreshAcceptedResult"}}}},
        {"if":{"properties":{"operation":{"const":"nominate"}},"required":["operation"]},"then":{"properties":{"result":{"$ref":"#/$defs/NominationResult"}}}},
        {"if":{"properties":{"operation":{"const":"report_conflict"}},"required":["operation"]},"then":{"properties":{"result":{"$ref":"#/$defs/ConflictResult"}}}},
        {"if":{"properties":{"operation":{"const":"research_context"}},"required":["operation"]},"then":{"properties":{"result":{"$ref":"#/$defs/ResearchContextResult"}}}}
      ],
      "additionalProperties":false
    }
  },
  "oneOf":[{"$ref":"#/$defs/Request"},{"$ref":"#/$defs/Response"}]
}
