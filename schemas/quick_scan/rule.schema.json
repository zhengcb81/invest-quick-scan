{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://invest-quick-scan.local/schemas/quick_scan/rule.schema.json",
  "title": "QuickScanRuleContract",
  "description": "结果筛选白名单与三值逻辑规则契约（Task C03，契约版本 1.0.0）",
  "type": "object",
  "definitions": {
    "RuleOutcome": {
      "type": "string",
      "enum": ["pass", "fail", "unknown"]
    },
    "ComparisonOperator": {
      "type": "string",
      "enum": [">", ">=", "<", "<=", "==", "!="]
    },
    "FieldThresholdCondition": {
      "type": "object",
      "required": ["field", "op", "value"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "op": { "$ref": "#/definitions/ComparisonOperator" },
        "value": { "type": "number" },
        "critical_risk_gate": {
          "type": "boolean",
          "default": false,
          "description": "若为true，无论其它条件如何，此字段不满足时必须为fail并标记致命风险（SC-09, RULE-02）。"
        }
      },
      "additionalProperties": false
    },
    "CompositeRule": {
      "type": "object",
      "oneOf": [
        { "required": ["all"] },
        { "required": ["any"] },
        { "required": ["not"] },
        { "required": ["condition"] }
      ],
      "properties": {
        "all": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/CompositeRule" },
          "description": "合取条件（三值逻辑优先级：fail > unknown > pass）"
        },
        "any": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/CompositeRule" },
          "description": "析取条件（三值逻辑优先级：pass > unknown > fail）"
        },
        "not": {
          "$ref": "#/definitions/CompositeRule",
          "description": "否定条件（pass<->fail, unknown保持unknown）"
        },
        "condition": { "$ref": "#/definitions/FieldThresholdCondition" }
      },
      "additionalProperties": false
    },
    "ScreeningPolicy": {
      "type": "object",
      "required": ["policy_id", "version", "name", "root_rule"],
      "properties": {
        "policy_id": { "type": "string", "pattern": "^[A-Za-z0-9_]+$" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "root_rule": { "$ref": "#/definitions/CompositeRule" },
        "critical_gates": {
          "type": "array",
          "items": { "$ref": "#/definitions/FieldThresholdCondition" },
          "default": []
        }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    { "$ref": "#/definitions/FieldThresholdCondition" },
    { "$ref": "#/definitions/CompositeRule" },
    { "$ref": "#/definitions/ScreeningPolicy" }
  ]
}
