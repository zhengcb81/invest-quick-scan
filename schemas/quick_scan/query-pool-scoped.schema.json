        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "$ref": "#/$defs/CandidatePayload"
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "operation",
        "message_type",
        "consumer_id",
        "requested_at",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.5.0"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "operation": {
          "const": "candidate_set"
        },
        "message_type": {
          "const": "response"
        },
        "response_at": {
          "type": "string",
          "format": "date-time"
        },
        "result": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "ok",
                "empty",
                "partial",
                "coverage_gap",
                "unavailable"
              ]
            },
            "rows": {
              "type": "array",
              "maxItems": 100
            },
            "total_subject_count": {
              "type": "integer",
              "minimum": 0,
              "description": "Legacy row count; see scope_counts for distinct companies and analysis subjects."
            },
            "matched_subject_count": {
              "type": "integer",
              "minimum": 0
            },
            "condition_counts": {
              "type": "object",
              "properties": {
                "pass": {
                  "type": "integer",
                  "minimum": 0
                },
                "fail": {
                  "type": "integer",
                  "minimum": 0
                },
                "unknown": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "pass",
                "fail",
                "unknown"
              ],
              "additionalProperties": false
            },
            "coverage": {
              "type": "object"
            },
            "watermark": {
              "type": "object",
              "properties": {
                "store_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "snapshot_id": {
                  "type": "string",
                  "pattern": "^psnap1_[a-f0-9]{64}$"
                },
                "query_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "pool_index_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "read_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "source_watermarks": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4
                },
                "source_consistency": {
                  "const": "sequential_owner_reads"
                },
                "qualification_watermark": {
                  "type": "object"
                }
              },
              "required": [
                "store_id",
                "snapshot_id",
                "query_sha256",
                "pool_index_sha256",
                "read_at",
                "source_watermarks",
                "source_consistency",
                "qualification_watermark"
              ],
              "additionalProperties": false
            },
            "next_cursor": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 512
                },
                {
                  "type": "null"
                }
              ]
            },
            "candidate_set": {
              "anyOf": [
                {
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ]
            },
            "screening_coverage_status": {
              "enum": [
                "not_requested",
                "not_covered",
                "partial",
                "complete",
                "unknown"
              ]
            },
            "financial_accuracy_proven": {
              "const": false
            },
            "facts_producer_ready": {
              "const": false
            },
            "full_C06_milestone_accepted": {
              "const": false
            },
            "API_requests": {
              "type": "integer",
              "const": 0
            },
            "calibers": {
              "type": "object",
              "maxProperties": 20000,
              "additionalProperties": {
                "type": "object"
              }
            },
            "scope_counts": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "active_company_count",
                "profiled_company_count",
                "profiled_analysis_subject_count",
                "profile_scope_row_count"
              ],
              "properties": {
                "active_company_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "profiled_company_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "profiled_analysis_subject_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "profile_scope_row_count": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "field_scope_coverage": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 200,
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "requested_scopes",
                  "requested_scope_row_count",
                  "covered_scope_row_count",
                  "missing_subject_refs",
                  "unresolved_company_count",
                  "status",
                  "scope_denominators",
                  "absent_requested_scopes"
                ],
                "properties": {
                  "requested_scopes": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 3,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "entity",
                        "security",
                        "segment"
                      ]
                    }
                  },
                  "requested_scope_row_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "covered_scope_row_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "missing_subject_refs": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/SubjectRef"
                    }
                  },
                  "unresolved_company_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "status": {
                    "enum": [
                      "unknown",
                      "complete",
                      "partial",
                      "not_covered"
                    ]
                  },
                  "scope_denominators": {
                    "type": "object",
                    "minProperties": 1,
                    "maxProperties": 3,
                    "propertyNames": {
                      "enum": [
                        "entity",
                        "security",
                        "segment"
                      ]
                    },
                    "additionalProperties": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "requested_scope_row_count",
                        "covered_scope_row_count"
                      ],
                      "properties": {
                        "requested_scope_row_count": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "covered_scope_row_count": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    }
                  },
                  "absent_requested_scopes": {
                    "type": "array",
                    "maxItems": 3,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "entity",
                        "security",
                        "segment"
                      ]
                    }
                  }
                }
              }
            }
          },
          "required": [
            "status",
            "rows",
            "total_subject_count",
            "matched_subject_count",
            "condition_counts",
            "coverage",
            "watermark",
            "next_cursor",
            "candidate_set",
            "screening_coverage_status",
            "financial_accuracy_proven",
            "facts_producer_ready",
            "full_C06_milestone_accepted",
            "API_requests",
            "calibers",
            "scope_counts",
            "field_scope_coverage"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "operation",
        "message_type",
        "response_at",
        "result"
      ],
      "additionalProperties": false
    }
  ]
}
