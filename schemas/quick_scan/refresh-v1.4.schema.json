{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iqs:quick-scan:refresh:1.4",
  "title": "Explicit native owner policy acceptance of retained budget-only exposure",
  "$defs": {
    "Request": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "iqs.refresh_request/1.4.0"
        },
        "operation": {
          "const": "request_refresh"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "consumer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "requested_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "source_query": {
          "oneOf": [
            {
              "$ref": "urn:iqs:quick-scan:query:2#/$defs/Request"
            },
            {
              "$ref": "urn:iqs:quick-scan:query:2.6#/$defs/Request"
            }
          ]
        },
        "subject_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:iqs:quick-scan:query:2#/$defs/SubjectRef"
          },
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true
        },
        "field_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "minItems": 1,
          "maxItems": 200,
          "uniqueItems": true
        },
        "origin_task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "cohort_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
        },
        "continuation_decision_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "question_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 1,
          "maxItems": 30,
          "uniqueItems": true
        }
      },
      "required": [
        "protocol",
        "operation",
        "request_id",
        "consumer_id",
        "requested_at",
        "source_query",
        "subject_refs",
        "field_ids",
        "origin_task_id",
        "reason",
        "cohort_id",
        "continuation_decision_ref",
        "question_ids"
      ],
      "additionalProperties": false
    },
    "OwnerState": {
      "type": "object",
      "properties": {
        "store_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "policy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "policy_version": {
          "type": "integer",
          "minimum": 1
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "ttl_hours": {
          "type": "integer",
          "minimum": 1
        },
        "member_versions": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 100,
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "anchors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "subject_ref": {
                "$ref": "urn:iqs:quick-scan:query:2#/$defs/SubjectRef"
              },
              "decision_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "anchor_version": {
                "type": "integer",
                "minimum": 1
              },
              "manifest_raw_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "identity_revision": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "subject_ref",
              "decision_id",
              "anchor_version",
              "manifest_raw_sha256",
              "identity_revision"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "subject_ref": {
                "$ref": "urn:iqs:quick-scan:query:2#/$defs/SubjectRef"
              },
              "field_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "question_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "decision": {
                "enum": [
                  "reuse",
                  "dispatch_new_work",
                  "dispatch_new_generation",
                  "resume_existing_work",
                  "deferred_unknown",
                  "deferred_scope_unbound",
                  "manual_refresh_required"
                ]
              },
              "generation": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reuse_observation_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^obs_[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "existing_work_status": {
                "enum": [
                  null,
                  "pending",
                  "leased",
                  "uncertain",
                  "result_ready",
                  "delivered",
                  "failed",
                  "cancelled"
                ]
              }
            },
            "required": [
              "subject_ref",
              "field_id",
              "question_id",
              "decision",
              "generation",
              "reuse_observation_id",
              "existing_work_status"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 20000,
          "uniqueItems": true
        },
        "quote": {
          "type": "object",
          "properties": {
            "currency": {
              "enum": [
                "USD",
                "CNY"
              ]
            },
            "max_cost_micros": {
              "type": "integer",
              "minimum": 0
            },
            "max_http_requests": {
              "type": "integer",
              "minimum": 0
            },
            "budget_state_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "budget_available": {
              "type": "boolean"
            },
            "planned_physical_requests": {
              "type": "integer",
              "minimum": 1,
              "maximum": 350
            },
            "retained_unreconciled_attempts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 350
            },
            "cash_actual_complete": {
              "const": false
            }
          },
          "required": [
            "currency",
            "max_cost_micros",
            "max_http_requests",
            "budget_state_sha256",
            "budget_available",
            "planned_physical_requests",
            "retained_unreconciled_attempts",
            "cash_actual_complete"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "store_id",
        "policy_id",
        "policy_version",
        "policy_sha256",
        "provider",
        "model",
        "ttl_hours",
        "member_versions",
        "anchors",
        "items",
        "quote"
      ],
      "additionalProperties": false
    },
    "Preview": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "stockwiki.refresh_preview/1.4.0"
        },
        "operation": {
          "const": "request_refresh"
        },
        "preview_id": {
          "type": "string",
          "pattern": "^rv1_[a-f0-9]{64}$"
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scope_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "owner_state_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_snapshot_id": {
          "type": "string",
          "pattern": "^snap2_[a-f0-9]{64}$"
        },
        "store_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "policy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "policy_version": {
          "type": "integer",
          "minimum": 1
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "subject_ref": {
                "$ref": "urn:iqs:quick-scan:query:2#/$defs/SubjectRef"
              },
              "field_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "question_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "decision": {
                "enum": [
                  "reuse",
                  "dispatch_new_work",
                  "dispatch_new_generation",
                  "resume_existing_work",
                  "deferred_unknown",
                  "deferred_scope_unbound",
                  "manual_refresh_required"
                ]
              },
              "generation": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reuse_observation_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^obs_[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "existing_work_status": {
                "enum": [
                  null,
                  "pending",
                  "leased",
                  "uncertain",
                  "result_ready",
                  "delivered",
                  "failed",
                  "cancelled"
                ]
              }
            },
            "required": [
              "subject_ref",
              "field_id",
              "question_id",
              "decision",
              "generation",
              "reuse_observation_id",
              "existing_work_status"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 20000,
          "uniqueItems": true
        },
        "quote": {
          "type": "object",
          "properties": {
            "currency": {
              "enum": [
                "USD",
                "CNY"
              ]
            },
            "max_cost_micros": {
              "type": "integer",
              "minimum": 0
            },
            "max_http_requests": {
              "type": "integer",
              "minimum": 0
            },
            "budget_state_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "budget_available": {
              "type": "boolean"
            },
            "planned_physical_requests": {
              "type": "integer",
              "minimum": 1,
              "maximum": 350
            },
            "retained_unreconciled_attempts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 350
            },
            "cash_actual_complete": {
              "const": false
            }
          },
          "required": [
            "currency",
            "max_cost_micros",
            "max_http_requests",
            "budget_state_sha256",
            "budget_available",
            "planned_physical_requests",
            "retained_unreconciled_attempts",
            "cash_actual_complete"
          ],
          "additionalProperties": false
        },
        "status": {
          "enum": [
            "ready",
            "noop",
            "blocked"
          ]
        },
        "requires_user_confirmation": {
          "type": "boolean"
        },
        "dispatch_started": {
          "const": false
        },
        "API_requests": {
          "const": 0
        }
      },
      "required": [
        "protocol",
        "operation",
        "preview_id",
        "request_sha256",
        "scope_sha256",
        "owner_state_sha256",
        "source_snapshot_id",
        "store_id",
        "policy_id",
        "policy_version",
        "policy_sha256",
        "provider",
        "model",
        "created_at",
        "expires_at",
        "items",
        "quote",
        "status",
        "requires_user_confirmation",
        "dispatch_started",
        "API_requests"
      ],
      "additionalProperties": false
    },
    "OwnerPolicy": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "stockwiki.refresh_owner_policy/1.4.0"
        },
        "policy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "policy_version": {
          "type": "integer",
          "minimum": 1
        },
        "owner_principal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "allowed_consumer_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true
        },
        "universe_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "field_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "minItems": 0,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "const": "mimo"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "ttl_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8760
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "subject_ref": {
                "$ref": "urn:iqs:quick-scan:query:2#/$defs/SubjectRef"
              },
              "subject_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "scope": {
                "enum": [
                  "entity",
                  "segment"
                ]
              },
              "scope_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            },
            "required": [
              "subject_ref",
              "subject_key",
              "scope",
              "scope_id"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        },
        "qa": {
          "type": "object",
          "properties": {
            "code_root": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "work_store": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "budget_policy_file": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "policy_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "route_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "provider_config_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "quote_schema_version": {
              "const": "1.4.0"
            },
            "admission_config": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "code_root",
            "work_store",
            "budget_policy_file",
            "policy_id",
            "route_id",
            "provider_config_ref",
            "quote_schema_version",
            "admission_config"
          ],
          "additionalProperties": false
        },
        "route_resolution": {
          "enum": [
            "explicit_routes",
            "current_owner_members"
          ]
        },
        "field_permission": {
          "enum": [
            "explicit_fields",
            "current_manifest"
          ]
        },
        "budget_exposure_acceptance": {
          "type": "object",
          "properties": {
            "continuation_decision_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "control": {
              "$ref": "#/$defs/BudgetExposureControl"
            }
          },
          "required": [
            "continuation_decision_ref",
            "control"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocol",
        "policy_id",
        "policy_version",
        "owner_principal",
        "allowed_consumer_ids",
        "universe_id",
        "field_ids",
        "provider",
        "model",
        "ttl_hours",
        "routes",
        "qa",
        "budget_exposure_acceptance"
      ],
      "additionalProperties": false
    },
    "FutureRequestCore": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "iqs.refresh_request/1.4.0"
        },
        "operation": {
          "const": "request_refresh"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "consumer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "requested_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "source_query": {
          "oneOf": [
            {
              "$ref": "urn:iqs:quick-scan:query:2#/$defs/Request"
            },
            {
              "$ref": "urn:iqs:quick-scan:query:2.6#/$defs/Request"
            }
          ]
        },
        "subject_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:iqs:quick-scan:query:2#/$defs/SubjectRef"
          },
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true
        },
        "field_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "minItems": 1,
          "maxItems": 200,
          "uniqueItems": true
        },
        "origin_task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "cohort_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
        },
        "question_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 1,
          "maxItems": 30,
          "uniqueItems": true
        }
      },
      "required": [
        "protocol",
        "operation",
        "request_id",
        "consumer_id",
        "requested_at",
        "source_query",
        "subject_refs",
        "field_ids",
        "origin_task_id",
        "reason",
        "cohort_id",
        "question_ids"
      ],
      "additionalProperties": false
    },
    "RetainedBudgetAttempt": {
      "type": "object",
      "properties": {
        "budget_attempt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "policy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "route_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "model_requested": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "quota_group": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "currency": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "pricing_basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "work_attempt_id": {
          "type": "null"
        },
        "pricing_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "reserved_cost_micros": {
          "type": "integer",
          "minimum": 1
        },
        "actual_cost_micros": {
          "type": "null"
        },
        "request_counted": {
          "const": 1
        },
        "in_flight": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "status": {
          "enum": [
            "outcome_uncertain",
            "response_unpriced"
          ]
        },
        "http_status_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "cost_source_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": "number"
        },
        "send_intent_at": {
          "type": "number"
        },
        "completed_at": {
          "type": [
            "number",
            "null"
          ]
        },
        "reconciled_at": {
          "type": "null"
        }
      },
      "required": [
        "budget_attempt_id",
        "policy_id",
        "policy_version",
        "route_id",
        "provider",
        "model_requested",
        "quota_group",
        "currency",
        "pricing_basis",
        "work_attempt_id",
        "pricing_ref",
        "reserved_cost_micros",
        "actual_cost_micros",
        "request_counted",
        "in_flight",
        "status",
        "http_status_code",
        "cost_source_ref",
        "created_at",
        "send_intent_at",
        "completed_at",
        "reconciled_at"
      ],
      "additionalProperties": false
    },
    "ExposureSnapshot": {
      "type": "object",
      "properties": {
        "protocol": {
          "enum": [
            "stockqa.owner_exposure_snapshot/1.0.0",
            "stockqa.owner_exposure_snapshot/1.2.0"
          ]
        },
        "policy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "policy_snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RetainedBudgetAttempt"
          },
          "maxItems": 2
        },
        "requests": {
          "type": "integer",
          "minimum": 0
        },
        "reserved_micros": {
          "type": "integer",
          "minimum": 0
        },
        "spent_micros": {
          "type": "integer",
          "minimum": 0
        },
        "cash_actual_complete": {
          "const": false
        },
        "fresh_budget": {
          "type": "boolean"
        },
        "owner_ack_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "protocol",
        "policy_id",
        "policy_snapshot_sha256",
        "attempts",
        "requests",
        "reserved_micros",
        "spent_micros",
        "cash_actual_complete"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "protocol": {
                "const": "stockqa.owner_exposure_snapshot/1.0.0"
              }
            },
            "required": [
              "protocol"
            ]
          },
          "then": {
            "properties": {
              "attempts": {
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "protocol": {
                "const": "stockqa.owner_exposure_snapshot/1.2.0"
              }
            },
            "required": [
              "protocol"
            ]
          },
          "then": {
            "required": [
              "fresh_budget",
              "owner_ack_ref"
            ],
            "properties": {
              "attempts": {
                "maxItems": 0
              },
              "fresh_budget": {
                "const": true
              },
              "requests": {
                "const": 0
              },
              "reserved_micros": {
                "const": 0
              },
              "spent_micros": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "ComparisonCell": {
      "type": "object",
      "properties": {
        "cell_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "question_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 1,
          "maxItems": 30,
          "uniqueItems": true
        },
        "question_body_sha256": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 30,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "subject_ref": {
          "$ref": "urn:iqs:quick-scan:query:2#/$defs/SubjectRef"
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "const": "mimo"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "route_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "quota_group": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "manifest_raw_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "controls": {
          "type": "object",
          "properties": {
            "thinking_enabled": {
              "const": true
            },
            "max_output_tokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32768
            },
            "strategy_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "const": "free_agent"
            },
            "search_policy_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "replicate_ordinal": {
              "type": "integer",
              "minimum": 1,
              "maximum": 350
            }
          },
          "required": [
            "thinking_enabled",
            "max_output_tokens",
            "strategy_id",
            "search_policy_sha256",
            "replicate_ordinal"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "cell_id",
        "question_ids",
        "question_body_sha256",
        "subject_ref",
        "provider",
        "model",
        "route_id",
        "quota_group",
        "generation",
        "manifest_raw_sha256",
        "controls"
      ],
      "additionalProperties": false
    },
    "BudgetExposureControl": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "stockqa.owner_budget_continuation/1.0.0"
        },
        "mode": {
          "const": "explicit_repeat_exposure"
        },
        "reference_scope": {
          "const": "unknown_reference_scope"
        },
        "purpose": {
          "const": "independent_comparison"
        },
        "consumer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "cohort_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "ledger_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "snapshot": {
          "$ref": "#/$defs/ExposureSnapshot"
        },
        "future_request_core": {
          "$ref": "#/$defs/FutureRequestCore"
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComparisonCell"
          },
          "minItems": 1,
          "maxItems": 1
        },
        "max_new_http_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 350
        },
        "valid_from": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "stop_evidence_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "additional_risk_hold_micros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000000
        },
        "no_retry_original_intents": {
          "const": true
        },
        "unknown_cash_remains_unknown": {
          "const": true
        },
        "retained_original_requests": {
          "const": true
        },
        "original_process_stopped": {
          "const": true
        }
      },
      "required": [
        "protocol",
        "mode",
        "reference_scope",
        "purpose",
        "consumer_id",
        "cohort_id",
        "ledger_path",
        "snapshot",
        "future_request_core",
        "cells",
        "max_new_http_requests",
        "valid_from",
        "expires_at",
        "stop_evidence_ref",
        "additional_risk_hold_micros",
        "no_retry_original_intents",
        "unknown_cash_remains_unknown",
        "retained_original_requests",
        "original_process_stopped"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Request"
    },
    {
      "$ref": "#/$defs/OwnerState"
    },
    {
      "$ref": "#/$defs/Preview"
    },
    {
      "$ref": "#/$defs/OwnerPolicy"
    }
  ]
}