{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "iqs.search_exposure/1.0.0",
  "title": "IQS search exposure (owner-approved bounded external search)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "consumer_id",
    "search_policy_ref",
    "search_policy_sha256",
    "max_search_queries_per_session",
    "max_search_cost_micros",
    "routes",
    "storage_rights",
    "approved_by",
    "approved_at"
  ],
  "properties": {
    "protocol": {
      "const": "iqs.search_exposure/1.0.0"
    },
    "consumer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "search_policy_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "search_policy_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "max_search_queries_per_session": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "max_search_cost_micros": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "route_id",
          "provider",
          "credential_env",
          "enabled",
          "max_queries"
        ],
        "properties": {
          "route_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "provider": {
            "enum": [
              "brave",
              "tavily",
              "deepseek",
              "zai"
            ]
          },
          "credential_env": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,60}$"
          },
          "enabled": {
            "const": true
          },
          "max_queries": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        }
      }
    },
    "storage_rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmed",
        "entitlement_ref"
      ],
      "properties": {
        "confirmed": {
          "const": true
        },
        "entitlement_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "approved_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "approved_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
