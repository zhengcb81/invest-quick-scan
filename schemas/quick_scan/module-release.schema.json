{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iqs:quick-scan:module-release:1",
  "title": "ImmutableQuickScanModuleRelease",
  "description": "S04 publication lock; historical runs resolve this exact archive, never the current mutable catalog.",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0",
        "2.0.0"
      ]
    },
    "release_id": {
      "type": "string",
      "pattern": "^modrel_[a-f0-9]{64}$"
    },
    "catalog_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "renderer_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "router_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "retired_question_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "module_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "kind": {
            "enum": [
              "common",
              "types",
              "industries",
              "stages",
              "overlays",
              "diagnostics",
              "common_extensions",
              "lenses"
            ]
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "artifact_ref": {
            "type": "string",
            "pattern": "^questions/releases/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.json$"
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "question_semantics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "question_id": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]*$"
                },
                "rubric_version": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                },
                "definition_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "question_id",
                "rubric_version",
                "definition_sha256"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "module_id",
          "kind",
          "version",
          "artifact_ref",
          "artifact_sha256",
          "question_semantics"
        ],
        "additionalProperties": false
      }
    },
    "routing_policy_ref": {
      "type": "string",
      "pattern": "^questions/releases/routing/[A-Za-z0-9_-]+\\.json$"
    },
    "routing_policy_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "release_id",
    "catalog_version",
    "renderer_version",
    "router_version",
    "retired_question_ids",
    "modules"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "2.0.0"
          }
        }
      },
      "then": {
        "required": [
          "routing_policy_ref",
          "routing_policy_sha256"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "routing_policy_ref"
              ]
            },
            {
              "required": [
                "routing_policy_sha256"
              ]
            }
          ]
        }
      }
    }
  ]
}
