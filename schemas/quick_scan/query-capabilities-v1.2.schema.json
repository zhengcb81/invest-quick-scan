    "SubjectRef": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string",
          "pattern": "^ENT_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "analysis_subject_id": {
          "type": "string",
          "pattern": "^ASJ_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "analysis_subject_revision": {
          "type": "integer",
          "minimum": 1
        },
        "primary_issuer_id": {
          "type": "string",
          "pattern": "^ENT_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "perimeter_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scope": {
          "enum": [
            "entity",
            "security",
            "segment"
          ]
        },
        "scope_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "security_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 160
        },
        "listing_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 160
        },
        "segment_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 160
        }
      },
      "required": [
        "entity_id",
        "analysis_subject_id",
        "analysis_subject_revision",
        "primary_issuer_id",
        "perimeter_sha256",
        "scope",
        "scope_id",
        "security_id",
        "listing_id",
        "segment_id"
      ],
      "additionalProperties": false
    },
    "Selection": {
      "type": "object",
      "properties": {
        "universe_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "field_ids": {
