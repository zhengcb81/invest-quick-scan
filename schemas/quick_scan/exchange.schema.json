{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iqs:quick-scan:exchange:1",
  "title": "QuickScanExchangeContract",
  "description": "轻量观察包、逐项导入ACK与研究线索；不包含公司文档或正式证据准入。",
  "$defs": {
    "Sha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "ExchangePackage": {
      "type": "object",
      "properties": {
        "schema_version": {"const":"1.0.0"},
        "package_id": {"type":"string","pattern":"^pkg_[a-f0-9]{64}$"},
        "package_sha256": {"$ref":"#/$defs/Sha256"},
        "producer": {
          "type":"object",
          "properties": {
            "component":{"const":"StockQAbyLLM"},
            "component_version":{"type":"string","minLength":1,"maxLength":80},
            "build_id":{"type":"string","minLength":1,"maxLength":160}
          },
          "required":["component","component_version","build_id"],
          "additionalProperties":false
        },
        "consumer": {
          "type":"object",
          "properties": {
            "component":{"const":"StockWiki"},
            "namespace":{"const":"quick_scan"},
            "minimum_schema_version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"}
          },
          "required":["component","namespace","minimum_schema_version"],
          "additionalProperties":false
        },
        "created_at":{"type":"string","format":"date-time"},
        "data_class":{"const":"lightweight_screening"},
        "required_capabilities":{
          "type":"array","uniqueItems":true,
          "items":{"enum":["entity_security_identity_v1","standard_observation_v1","score_v1","fact_v1"]}
        },
        "contract_versions":{
          "type":"object",
          "properties":{
            "identity_schema":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},
            "answer_schema":{"type":"string","minLength":1,"maxLength":80},
            "observation_schema":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},
            "question_catalog":{"type":"string","minLength":1,"maxLength":80},
            "model_policy_schema":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"}
          },
          "required":["identity_schema","answer_schema","observation_schema","question_catalog","model_policy_schema"],
          "additionalProperties":false
        },
        "document_payloads_included":{"const":false},
        "items":{
          "type":"array","minItems":1,"maxItems":100,
          "items":{"$ref":"#/$defs/ObservationItem"}
        },
        "extensions":{
          "type":"array","maxItems":0,
          "description":"Contract 1.0.0 has no registered extension payloads. Additive capabilities require a named lightweight schema and a contract-version change; arbitrary objects are rejected.",
          "items":{
            "type":"object",
            "properties":{
              "capability_id":{"type":"string","minLength":1,"maxLength":120},
              "required":{"type":"boolean"},
              "payload":{"type":"object"}
            },
            "required":["capability_id","required","payload"],
            "additionalProperties":false
          }
        }
      },
      "required":["schema_version","package_id","package_sha256","producer","consumer","created_at","data_class","required_capabilities","contract_versions","document_payloads_included","items","extensions"],
      "additionalProperties":false
    },
    "ObservationItem": {
      "type":"object",
      "properties":{
        "item_id":{"type":"string","pattern":"^itm_[a-f0-9]{64}$"},
        "observation_id":{"type":"string","pattern":"^obs_[a-f0-9]{64}$"},
        "payload_sha256":{"$ref":"#/$defs/Sha256"},
        "observation":{"$ref":"urn:iqs:observation:1"}
      },
      "required":["item_id","observation_id","payload_sha256","observation"],
      "additionalProperties":false
    },
    "ImportAck": {
      "type":"object",
      "properties":{
        "schema_version":{"const":"1.0.0"},
        "ack_id":{"type":"string","pattern":"^ack_[A-Za-z0-9_-]{8,160}$"},
        "package_id":{"type":"string","pattern":"^pkg_[a-f0-9]{64}$"},
        "item_id":{"type":"string","pattern":"^itm_[a-f0-9]{64}$"},
        "observation_id":{"type":"string","pattern":"^obs_[a-f0-9]{64}$"},
        "payload_sha256":{"$ref":"#/$defs/Sha256"},
        "status":{"enum":["accepted","already_present","conflict","rejected"]},
        "error_code":{"type":["string","null"],"enum":[null,"immutable_key_hash_conflict","unsupported_schema","missing_entity","unknown_question","invalid_payload","lineage_violation"]},
        "received_at":{"type":"string","format":"date-time"},
        "consumer":{
          "type":"object",
          "properties":{
            "component":{"const":"StockWiki"},
            "namespace":{"const":"quick_scan"},
            "store_id":{"type":"string","minLength":1,"maxLength":160}
          },
          "required":["component","namespace","store_id"],
          "additionalProperties":false
        }
      },
      "required":["schema_version","ack_id","package_id","item_id","observation_id","payload_sha256","status","error_code","received_at","consumer"],
      "allOf":[
        {"if":{"properties":{"status":{"enum":["accepted","already_present"]}},"required":["status"]},"then":{"properties":{"error_code":{"type":"null"}}}},
        {"if":{"properties":{"status":{"const":"conflict"}},"required":["status"]},"then":{"properties":{"error_code":{"const":"immutable_key_hash_conflict"}}}},
        {"if":{"properties":{"status":{"const":"rejected"}},"required":["status"]},"then":{"properties":{"error_code":{"enum":["unsupported_schema","missing_entity","unknown_question","invalid_payload","lineage_violation"]}}}}
      ],
      "additionalProperties":false
    },
    "ResearchLead": {
      "type":"object",
      "properties":{
        "schema_version":{"const":"1.0.0"},
        "origin_task_id":{"type":"string","minLength":1,"maxLength":160},
        "entity_id":{"type":"string","pattern":"^ENT_[A-Za-z0-9_]+$"},
        "observation_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^obs_[a-f0-9]{64}$"},"maxItems":100},
        "upstream_observation_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^obs_[a-f0-9]{64}$"},"maxItems":100},
        "evidence_urls":{"type":"array","items":{"type":"string","format":"uri","pattern":"^https?://","maxLength":1800},"maxItems":100},
        "formal_evidence_accepted":{"const":false},
        "handoff_reason":{"type":"string","minLength":1,"maxLength":500}
      },
      "required":["schema_version","origin_task_id","entity_id","observation_ids","upstream_observation_ids","evidence_urls","formal_evidence_accepted","handoff_reason"],
      "additionalProperties":false
    }
  },
  "oneOf":[
    {"$ref":"#/$defs/ExchangePackage"},
    {"$ref":"#/$defs/ImportAck"},
    {"$ref":"#/$defs/ResearchLead"}
  ]
}
