{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iqs:scoring-rubric:1",
  "$ref": "#/$defs/Release",
  "$defs": {
    "Hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "Text": {"type": "string", "minLength": 1, "maxLength": 200},
    "Version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "Scope": {"enum": ["entity", "security", "segment"]},
    "Dimension": {"enum": ["business", "moat", "execution", "financial", "governance", "resilience", "growth", "valuation"]},
    "CheckLevel": {"enum": ["unverified_model_output", "execution_verified", "screening_audited", "formal_research_accepted"]},
    "Date": {"type": "string", "format": "date"},
    "UTC": {"type": "string", "format": "date-time", "pattern": "(Z|\\+00:00)$"},
    "Question": {
      "type": "object", "additionalProperties": false,
      "required": ["construct_id", "question_id", "question_definition_sha256", "dimension", "scope", "rubric_version"],
      "properties": {
        "construct_id": {"type": ["string", "null"], "pattern": "^IQS_[0-9]{2}$"},
        "question_id": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
        "question_definition_sha256": {"$ref": "#/$defs/Hash"},
        "dimension": {"$ref": "#/$defs/Dimension"},
        "scope": {"$ref": "#/$defs/Scope"},
        "rubric_version": {"$ref": "#/$defs/Version"}
      }
    },
    "Weights": {
      "type": "object", "additionalProperties": false,
      "required": ["business", "moat", "execution", "financial", "governance", "resilience"],
      "properties": {
        "business": {"type": "integer", "minimum": 1, "maximum": 100},
        "moat": {"type": "integer", "minimum": 1, "maximum": 100},
        "execution": {"type": "integer", "minimum": 1, "maximum": 100},
        "financial": {"type": "integer", "minimum": 1, "maximum": 100},
        "governance": {"type": "integer", "minimum": 1, "maximum": 100},
        "resilience": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    },
    "Release": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "version", "rubric_release_id", "method_id", "owner", "cohort", "valid_from_utc", "valid_until_utc", "calibration_sample_refs", "minimum_check_level", "dimension_min_coverage", "quality_min_coverage", "quality_weights", "core_basket", "critical_extensions", "supersedes"],
      "properties": {
        "schema_version": {"const": "1.0.0"}, "version": {"$ref": "#/$defs/Version"},
        "rubric_release_id": {"type": "string", "pattern": "^rubrel_[a-f0-9]{64}$"},
        "method_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,100}$"},
        "owner": {"const": "iqs"},
        "cohort": {"enum": ["operating", "bank", "insurer", "property_developer", "property_owner", "capital_markets", "holding", "pre_revenue", "cyclical"]},
        "valid_from_utc": {"$ref": "#/$defs/UTC"},
        "valid_until_utc": {"anyOf": [{"$ref": "#/$defs/UTC"}, {"type": "null"}]},
        "calibration_sample_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/Hash"}},
        "minimum_check_level": {"enum": ["execution_verified", "screening_audited", "formal_research_accepted"]},
        "dimension_min_coverage": {"type": "number", "minimum": 0.7, "maximum": 1},
        "quality_min_coverage": {"type": "number", "minimum": 0.8, "maximum": 1},
        "quality_weights": {"$ref": "#/$defs/Weights"},
        "core_basket": {"type": "array", "minItems": 24, "maxItems": 24, "items": {"$ref": "#/$defs/Question"}},
        "critical_extensions": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/Question"}},
        "supersedes": {"type": ["string", "null"], "pattern": "^rubrel_[a-f0-9]{64}$"}
      }
    },
    "Row": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "construct_id", "dimension", "aggregation_role", "question_definition_sha256", "question_semantic_sha256", "scope", "scope_id", "scope_basis", "period_start", "period_end", "period_basis", "provider", "model", "model_config_sha256", "status", "score", "confidence", "check_level", "check_level_receipt_id", "is_audited_na", "critical", "freshness", "observation_id", "observation_sha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
        "construct_id": {"type": ["string", "null"], "pattern": "^IQS_[0-9]{2}$"},
        "dimension": {"$ref": "#/$defs/Dimension"},
        "aggregation_role": {"enum": ["quality_core", "growth_core", "valuation_core", "diagnostic_only"]},
        "question_definition_sha256": {"$ref": "#/$defs/Hash"},
        "question_semantic_sha256": {"$ref": "#/$defs/Hash"},
        "scope": {"$ref": "#/$defs/Scope"},
        "scope_id": {"$ref": "#/$defs/Text"}, "scope_basis": {"$ref": "#/$defs/Text"},
        "period_start": {"anyOf": [{"$ref": "#/$defs/Date"}, {"type": "null"}]},
        "period_end": {"anyOf": [{"$ref": "#/$defs/Date"}, {"type": "null"}]},
        "period_basis": {"type": ["string", "null"], "minLength": 1, "maxLength": 100},
        "provider": {"type": ["string", "null"], "minLength": 1, "maxLength": 100},
        "model": {"type": ["string", "null"], "minLength": 1, "maxLength": 100},
        "model_config_sha256": {"anyOf": [{"$ref": "#/$defs/Hash"}, {"type": "null"}]},
        "status": {"enum": ["scored", "unknown", "insufficient_evidence", "not_applicable", "search_unavailable", "error"]},
        "score": {"type": ["integer", "null"], "minimum": 1, "maximum": 10},
        "confidence": {"enum": ["high", "medium", "low"]},
        "check_level": {"$ref": "#/$defs/CheckLevel"},
        "check_level_receipt_id": {"type": ["string", "null"], "pattern": "^RCP_[A-Za-z0-9_.-]+$"},
        "is_audited_na": {"type": "boolean"}, "critical": {"type": "boolean"},
        "freshness": {"enum": ["fresh", "stale", "unknown"]},
        "observation_id": {"type": "string", "pattern": "^OBS_[A-Za-z0-9_.-]+$"},
        "observation_sha256": {"$ref": "#/$defs/Hash"}
      }
    },
    "Snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "entity_id", "cohort", "information_as_of", "records"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "entity_id": {"$ref": "#/$defs/Text"}, "cohort": {"$ref": "#/$defs/Text"},
        "information_as_of": {"$ref": "#/$defs/Date"},
        "records": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/Row"}}
      }
    }
  }
}
