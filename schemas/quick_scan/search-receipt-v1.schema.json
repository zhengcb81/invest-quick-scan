{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "iqs.search_receipt/1.0.0",
  "title": "Verified search receipt bound to an owner search exposure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "exposure_sha256",
    "policy_sha256",
    "provider",
    "route_id",
    "query",
    "requested_at",
    "completed_at",
    "status",
    "results",
    "result_count",
    "cost_micros",
    "currency",
    "response_sha256"
  ],
  "properties": {
    "protocol": {
      "const": "iqs.search_receipt/1.0.0"
    },
    "exposure_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provider": {
      "enum": [
        "deepseek",
        "brave",
        "tavily",
        "zai"
      ]
    },
    "route_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "requested_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "completed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "status": {
      "enum": [
        "ok",
        "empty",
        "unavailable"
      ]
    },
    "results": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "url",
          "snippet",
          "rerank_score"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "snippet": {
            "type": "string",
            "maxLength": 2000
          },
          "summary": {
            "type": "string",
            "maxLength": 4000
          },
          "content": {
            "type": "string",
            "maxLength": 20000
          },
          "rerank_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 3
          }
        }
      }
    },
    "result_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "cost_micros": {
      "type": "integer",
      "minimum": 0
    },
    "currency": {
      "enum": [
        "USD",
        "CNY"
      ]
    },
    "response_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "error_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "results": {
            "minItems": 1
          },
          "result_count": {
            "minimum": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "empty"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "results": {
            "maxItems": 0
          },
          "result_count": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "unavailable"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "error_reason"
        ],
        "properties": {
          "results": {
            "maxItems": 0
          },
          "result_count": {
            "const": 0
          },
          "cost_micros": {
            "const": 0
          }
        }
      }
    }
  ]
}
