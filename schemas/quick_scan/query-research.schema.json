{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iqs:query-research:2.4",
  "oneOf": [
    {
      "$ref": "#/$defs/Request"
    },
    {
      "$ref": "#/$defs/Response"
    }
  ],
  "$defs": {
    "SubjectRef": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string",
          "pattern": "^ENT_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "analysis_subject_id": {
          "type": "string",
          "pattern": "^ASJ_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "analysis_subject_revision": {
          "type": "integer",
          "minimum": 1
        },
        "primary_issuer_id": {
          "type": "string",
          "pattern": "^ENT_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "perimeter_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scope": {
          "enum": [
            "entity",
            "security",
            "segment"
          ]
        },
        "scope_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "security_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 160
        },
        "listing_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 160
        },
        "segment_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 160
        }
      },
      "required": [
        "entity_id",
        "analysis_subject_id",
        "analysis_subject_revision",
        "primary_issuer_id",
        "perimeter_sha256",
        "scope",
        "scope_id",
        "security_id",
        "listing_id",
        "segment_id"
      ],
      "additionalProperties": false
    },
    "Request": {
      "type": "object",
      "properties": {
        "message_type": {
          "const": "request"
        },
        "schema_version": {
          "const": "2.4.0"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "operation": {
          "const": "research_context"
        },
        "consumer_id": {
          "enum": [
            "user_ui",
            "analyze-theme-value-chain",
            "industry-research",
            "invest-quick-scan"
          ]
        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "type": "object",
          "properties": {
            "subject_refs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SubjectRef"
              },
              "minItems": 1,
              "maxItems": 100
            },
            "field_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "uniqueItems": true,
              "minItems": 1,
              "maxItems": 200
            },
            "information_cutoff": {
              "type": "string",
              "format": "date"
            },
            "include_history": {
              "type": "boolean"
            },
            "model_filter": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "properties": {
                    "provider": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "model_resolved": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    }
                  },
                  "required": [
                    "provider",
                    "model_resolved"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "snapshot_id": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 160
            },
            "origin_task_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "purpose": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "observation_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^obs_[a-f0-9]{64}$"
              },
              "uniqueItems": true,
              "maxItems": 100
            },
            "target_observation_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^obs_[a-f0-9]{64}$"
              },
              "uniqueItems": true,
              "maxItems": 100
            }
          },
          "required": [
            "subject_refs",
            "field_ids",
            "information_cutoff",
            "include_history",
            "model_filter",
            "snapshot_id",
            "origin_task_id",
            "purpose",
            "observation_ids",
            "target_observation_ids"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "message_type",
        "schema_version",
        "request_id",
        "operation",
        "consumer_id",
        "requested_at",
        "payload"
      ],
      "additionalProperties": false
    },
    "Response": {
      "type": "object",
      "properties": {
        "message_type": {
          "const": "response"
        },
        "schema_version": {
          "const": "2.4.0"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "operation": {
          "const": "research_context"
        },
        "response_at": {
          "type": "string",
          "format": "date-time"
        },
        "result": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "ok",
                "partial",
                "coverage_gap",
                "unavailable"
              ]
            },
            "profile_result": {
              "type": "object",
              "properties": {
                "status": {
                  "enum": [
                    "ok",
                    "partial",
                    "coverage_gap",
                    "unavailable"
                  ]
                },
                "profiles": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "subject_ref": {
                        "$ref": "#/$defs/SubjectRef"
                      },
                      "canonical_name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "observations": {
                        "type": "array",
                        "maxItems": 1000,
                        "items": {
                          "$ref": "#/$defs/ObservationProjection"
                        }
                      }
                    },
                    "required": [
                      "subject_ref",
                      "canonical_name",
                      "observations"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 100
                },
                "missing_subject_refs": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/SubjectRef"
                  },
                  "maxItems": 100
                },
                "coverage": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "enum": [
                        "complete",
                        "partial",
                        "not_covered",
                        "unknown"
                      ]
                    },
                    "requested_markets": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "enum": [
                          "CN",
                          "HK",
                          "US"
                        ]
                      }
                    },
                    "covered_markets": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "enum": [
                          "CN",
                          "HK",
                          "US"
                        ]
                      }
                    },
                    "requested_field_ids": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      }
                    },
                    "covered_field_ids": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      }
                    },
                    "missing_field_ids": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      }
                    },
                    "scores_available": {
                      "type": "boolean"
                    },
                    "facts_available": {
                      "type": "boolean"
                    },
                    "reason": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 350
                    }
                  },
                  "required": [
                    "status",
                    "requested_markets",
                    "covered_markets",
                    "requested_field_ids",
                    "covered_field_ids",
                    "missing_field_ids",
                    "scores_available",
                    "facts_available",
                    "reason"
                  ],
                  "additionalProperties": false
                },
                "watermark": {
                  "type": "object",
                  "properties": {
                    "store_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "snapshot_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "member_sequence": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "observation_sequence": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "ack_sequence": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "read_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "query_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "snapshot_content_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "read_consistency": {
                      "const": "sequential_owner_reads"
                    },
                    "source_watermarks": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 12,
                      "items": {
                        "type": "object",
                        "properties": {
                          "namespace": {
                            "enum": [
                              "identity",
                              "analysis_subjects",
                              "observations",
                              "evidence",
                              "universe"
                            ]
                          },
                          "schema_version": {
                            "type": [
                              "integer",
                              "null"
                            ],
                            "minimum": 0
                          },
                          "status": {
                            "enum": [
                              "available",
                              "missing",
                              "schema_unavailable",
                              "read_error"
                            ]
                          },
                          "sequence": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "read_at": {
                            "type": "string",
                            "format": "date-time",
                            "pattern": "Z$"
                          },
                          "content_sha256": {
                            "anyOf": [
                              {
                                "type": "string",
                                "pattern": "^[a-f0-9]{64}$"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "required": [
                          "namespace",
                          "schema_version",
                          "status",
                          "sequence",
                          "read_at",
                          "content_sha256"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "store_id",
                    "snapshot_id",
                    "member_sequence",
                    "observation_sequence",
                    "ack_sequence",
                    "read_at",
                    "query_sha256",
                    "snapshot_content_sha256",
                    "read_consistency",
                    "source_watermarks"
                  ],
                  "additionalProperties": false
                },
                "legacy_unbound_observations": {
                  "type": "array",
                  "maxItems": 1000,
                  "items": {
                    "$ref": "#/$defs/ObservationProjection"
                  }
                }
              },
              "required": [
                "status",
                "profiles",
                "missing_subject_refs",
                "coverage",
                "watermark",
                "legacy_unbound_observations"
              ],
              "additionalProperties": false
            },
            "leads": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ResearchLead"
              },
              "maxItems": 1000
            },
            "missing_observation_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^obs_[a-f0-9]{64}$"
              },
              "uniqueItems": true,
              "maxItems": 100
            },
            "lineage_source_status": {
              "enum": [
                "not_recorded",
                "recorded"
              ]
            },
            "lineage_by_observation": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^obs_[a-f0-9]{64}$"
              },
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^obs_[a-f0-9]{64}$"
                },
                "uniqueItems": true,
                "maxItems": 100
              },
              "maxProperties": 1000
            },
            "query_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "snapshot_id": {
              "type": "string",
              "pattern": "^rsnap1_[a-f0-9]{64}$"
            },
            "formal_evidence_accepted": {
              "const": false
            },
            "financial_accuracy_proven": {
              "const": false
            }
          },
          "required": [
            "status",
            "profile_result",
            "leads",
            "missing_observation_ids",
            "lineage_source_status",
            "lineage_by_observation",
            "query_sha256",
            "snapshot_id",
            "formal_evidence_accepted",
            "financial_accuracy_proven"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "message_type",
        "schema_version",
        "request_id",
        "operation",
        "response_at",
        "result"
      ],
      "additionalProperties": false
    },
    "SubjectBinding": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "stockwiki.observation_subject_binding/1.0.0"
        },
        "receipt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "subject_ref": {
          "$ref": "#/$defs/SubjectRef"
        },
        "observation_id": {
          "type": "string",
          "pattern": "^obs_[a-f0-9]{64}$"
        },
        "payload_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "execution_request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "execution_attempt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "dispatch_identity_snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "dispatch_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "recorded_before_send_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "protocol",
        "receipt_id",
        "subject_ref",
        "observation_id",
        "payload_sha256",
        "execution_request_id",
        "execution_attempt_id",
        "dispatch_identity_snapshot_sha256",
        "dispatch_manifest_sha256",
        "recorded_before_send_at"
      ],
      "additionalProperties": false
    },
    "ObservationProjection": {
      "type": "object",
      "properties": {
        "observation_id": {
          "type": "string",
          "pattern": "^obs_[a-f0-9]{64}$"
        },
        "payload_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "raw_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "original_json_base64": {
          "type": "string",
          "minLength": 4,
          "maxLength": 699052
        },
        "observation_wire_profile": {
          "const": "stockwiki-portable-observation/1.0.0"
        },
        "binding_status": {
          "enum": [
            "bound",
            "legacy_unbound"
          ]
        },
        "subject_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/SubjectBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "observation_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "ack_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "ingest_status": {
          "enum": [
            "accepted",
            "already_present"
          ]
        },
        "qualification_status": {
          "enum": [
            "review_pending",
            "independently_checked",
            "rejected",
            "conflict"
          ]
        }
      },
      "required": [
        "observation_id",
        "payload_sha256",
        "raw_sha256",
        "original_json_base64",
        "observation_wire_profile",
        "binding_status",
        "subject_binding",
        "observation_sequence",
        "ack_sequence",
        "ingest_status",
        "qualification_status"
      ],
      "additionalProperties": false
    },
    "ResearchLead": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.0.0"
        },
        "origin_task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "subject_ref": {
          "$ref": "#/$defs/SubjectRef"
        },
        "observation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^obs_[a-f0-9]{64}$"
          },
          "uniqueItems": true,
          "maxItems": 1,
          "minItems": 1
        },
        "upstream_observation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^obs_[a-f0-9]{64}$"
          },
          "uniqueItems": true,
          "maxItems": 1000
        },
        "upstream_closure_status": {
          "enum": [
            "unknown",
            "complete",
            "missing_ancestor",
            "cycle",
            "limit_exceeded"
          ]
        },
        "evidence_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://",
            "maxLength": 1800
          },
          "uniqueItems": true,
          "maxItems": 20
        },
        "handoff_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "formal_evidence_accepted": {
          "const": false
        },
        "independent_support_by_target": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^obs_[a-f0-9]{64}$"
          },
          "additionalProperties": {
            "type": "boolean"
          },
          "maxProperties": 100
        }
      },
      "required": [
        "schema_version",
        "origin_task_id",
        "subject_ref",
        "observation_ids",
        "upstream_observation_ids",
        "upstream_closure_status",
        "evidence_urls",
        "handoff_reason",
        "formal_evidence_accepted",
        "independent_support_by_target"
      ],
      "additionalProperties": false
    }
  }
}
