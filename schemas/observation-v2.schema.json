{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "observation_id": {
      "type": "string",
      "pattern": "^obs_[a-f0-9]{64}$"
    },
    "entity_id": {
      "type": "string",
      "pattern": "^ENT_[A-Za-z0-9_]+$"
    },
    "security_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        {
          "type": "null"
        }
      ]
    },
    "segment_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        {
          "type": "null"
        }
      ]
    },
    "field_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "construct_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        {
          "type": "null"
        }
      ]
    },
    "question_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "question_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "template_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "module_package_id": {
      "type": "string",
      "pattern": "^pkg_[a-f0-9]{64}$"
    },
    "module_release_id": {
      "type": "string",
      "pattern": "^modrel_[a-f0-9]{64}$"
    },
    "question_definition_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "question_semantic_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cycle_sensitive": {
      "type": "boolean"
    },
    "method_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "scope": {
      "enum": [
        "entity",
        "security",
        "segment"
      ]
    },
    "cohort": {
      "type": "object",
      "properties": {
        "company_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "industries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "maxItems": 2
        },
        "stage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "subtype": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "company_type",
        "industries",
        "stage",
        "subtype"
      ],
      "additionalProperties": false
    },
    "information_cutoff": {
      "type": "string",
      "format": "date"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "scan_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "inputset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "task_mode": {
      "enum": [
        "primary",
        "comparison"
      ]
    },
    "comparison_group_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "execution": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "model_requested": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "model_resolved": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            {
              "type": "null"
            }
          ]
        },
        "model_revision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            {
              "type": "null"
            }
          ]
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "answered_at": {
          "type": "string",
          "format": "date-time"
        },
        "search_status": {
          "enum": [
            "executed",
            "unavailable",
            "unverified"
          ]
        },
        "search_receipt_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            {
              "type": "null"
            }
          ]
        },
        "prompt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "provider",
        "model_requested",
        "model_resolved",
        "model_revision",
        "request_id",
        "attempt_id",
        "started_at",
        "answered_at",
        "search_status",
        "search_receipt_id",
        "prompt_sha256"
      ],
      "additionalProperties": false
    },
    "answer": {
      "$ref": "urn:iqs:answer-content:1"
    },
    "evidence_review_status": {
      "enum": [
        "unreviewed",
        "reviewed"
      ]
    },
    "work_item_id": {
      "type": "string",
      "pattern": "^WORK_[A-Za-z0-9_.-]+$"
    },
    "work_generation": {
      "type": "integer",
      "minimum": 1
    },
    "scope_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,160}$"
    },
    "question_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "routing_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "identity_revision": {
      "type": "integer",
      "minimum": 1
    },
    "source_binding_version": {
      "type": "integer",
      "minimum": 1
    },
    "identity_state_at_answer": {
      "enum": [
        "provisional",
        "verified"
      ]
    },
    "source_binding_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^BND_[A-Za-z0-9_]+$"
      }
    }
  },
  "required": [
    "schema_version",
    "observation_id",
    "entity_id",
    "security_id",
    "segment_id",
    "field_id",
    "construct_id",
    "question_id",
    "question_version",
    "template_version",
    "method_id",
    "scope",
    "cohort",
    "information_cutoff",
    "run_id",
    "scan_id",
    "inputset_id",
    "task_mode",
    "comparison_group_id",
    "observed_at",
    "execution",
    "answer",
    "evidence_review_status",
    "work_item_id",
    "work_generation",
    "scope_id",
    "question_fingerprint",
    "routing_fingerprint",
    "identity_revision",
    "source_binding_version",
    "identity_state_at_answer",
    "source_binding_refs"
  ],
  "allOf": [
    {
      "required": [
        "module_package_id",
        "module_release_id",
        "question_definition_sha256",
        "question_semantic_sha256",
        "cycle_sensitive"
      ]
    }
  ],
  "additionalProperties": false,
  "$id": "urn:iqs:observation:2",
  "title": "Identity-bound QuickScan Observation v2",
  "description": "Separate v2 envelope. Legacy S05 published ingest and Exchange v1 must not interpret it."
}
