{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "execution_owner": {
      "const": "StockQAbyLLM"
    },
    "configured": {
      "type": "boolean"
    },
    "dispatch": {
      "type": "object",
      "properties": {
        "max_in_flight_total": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "max_questions_per_pack": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "one_entity_per_pack": {
          "const": true
        },
        "separate_score_and_fact_packs": {
          "const": true
        },
        "on_preferred_capacity_full": {
          "const": "wait"
        },
        "speculative_racing": {
          "const": false
        }
      },
      "required": [
        "max_in_flight_total",
        "max_questions_per_pack",
        "one_entity_per_pack",
        "separate_score_and_fact_packs",
        "on_preferred_capacity_full",
        "speculative_racing"
      ],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "max_cost": {
          "type": "number",
          "minimum": 0
        },
        "max_requests": {
          "type": "integer",
          "minimum": 0
        },
        "reset_on_restart": {
          "const": false
        }
      },
      "required": [
        "currency",
        "max_cost",
        "max_requests",
        "reset_on_restart"
      ],
      "additionalProperties": false
    },
    "quota_groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "max_in_flight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "window_seconds_hint": {
            "type": ["integer", "null"],
            "minimum": 1
          },
          "unknown_reset_cooldown_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400
          }
        },
        "required": [
          "id",
          "max_in_flight",
          "window_seconds_hint",
          "unknown_reset_cooldown_seconds"
        ],
        "additionalProperties": false
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "enabled": {
            "type": "boolean"
          },
          "provider_config_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "quota_group": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "max_in_flight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          }
        },
        "required": [
          "id",
          "enabled",
          "provider_config_ref",
          "model",
          "quota_group",
          "max_in_flight"
        ],
        "additionalProperties": false
      }
    },
    "fallback": {
      "type": "object",
      "properties": {
        "on_quota_exhausted": {
          "const": "cooldown_group_then_next"
        },
        "on_rate_limit": {
          "const": "respect_retry_after_then_next"
        },
        "on_auth_error": {
          "const": "disable_route_then_next"
        },
        "on_timeout": {
          "const": "reconcile_receipt_before_retry"
        },
        "on_low_score": {
          "const": "accept"
        },
        "on_unknown_answer": {
          "const": "accept_with_gap"
        },
        "max_attempts_per_dispatch_round": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        }
      },
      "required": [
        "on_quota_exhausted",
        "on_rate_limit",
        "on_auth_error",
        "on_timeout",
        "on_low_score",
        "on_unknown_answer",
        "max_attempts_per_dispatch_round"
      ],
      "additionalProperties": false
    },
    "resume": {
      "type": "object",
      "properties": {
        "success_checkpoint": {
          "const": "per_question"
        },
        "replay_outbox_before_dispatch": {
          "const": true
        },
        "preserve_uncertain_requests": {
          "const": true
        },
        "persist_cooldowns_and_budget": {
          "const": true
        }
      },
      "required": [
        "success_checkpoint",
        "replay_outbox_before_dispatch",
        "preserve_uncertain_requests",
        "persist_cooldowns_and_budget"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "policy_id",
    "execution_owner",
    "configured",
    "dispatch",
    "budget",
    "quota_groups",
    "models",
    "fallback",
    "resume"
  ],
  "additionalProperties": false
}
