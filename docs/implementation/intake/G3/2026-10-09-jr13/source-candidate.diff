+def _validate_json_value(value: Any) -> None:
+    """Validate direct objects too; shared aliases are allowed, cycles are not."""
+    active: set[int] = set()
+    stack: list[tuple[Any, bool]] = [(value, False)]
+    while stack:
+        node, leaving = stack.pop()
+        if leaving:
+            active.remove(id(node))
+        elif isinstance(node, (dict, list)):
+            if id(node) in active:
+                raise _reject("json_value_invalid", "circular object")
+            if isinstance(node, dict) and any(not isinstance(key, str) for key in node):
+                raise _reject("json_value_invalid", "object keys must be strings")
+            active.add(id(node))
+            stack.append((node, True))
+            children = node.values() if isinstance(node, dict) else node
+            stack.extend((child, False) for child in children)
+        elif isinstance(node, float):
+            if not math.isfinite(node):
+                raise _reject("json_number_nonfinite", str(node))
+        elif node is not None and not isinstance(node, (str, int, bool)):
+            raise _reject("json_value_invalid", type(node).__name__)
+
