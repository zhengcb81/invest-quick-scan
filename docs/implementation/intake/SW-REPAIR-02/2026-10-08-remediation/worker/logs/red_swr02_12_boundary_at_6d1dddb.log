    @pytest.mark.parametrize("mutation", ["format_version", "owner_module", "workspace_root"])
    def test_unknown_registry_version_or_foreign_owner_never_grants_delete(
        tmp_path: Path, mutation: str
    ) -> None:
        """SR02-3: delete authority is bound to registry version + owner module +
        workspace. An unknown version fails closed; a foreign record is kept and
        reported. Nothing rebuilds or adopts a damaged registration."""
        paths = _two_owned_backups(tmp_path)
        root = quick_scan_backup_root(paths)
        registry_path = root / OWNER_REGISTRY_NAME
        registry = json.loads(registry_path.read_text(encoding="utf-8"))
        if mutation == "format_version":
            registry[mutation] = "999.0.0"
        else:
            old = next(r for r in registry["records"] if r["name"] == "backup_a")
            old[mutation] = (
                "foreign-module" if mutation == "owner_module" else str(tmp_path / "another-workspace")
            )
        registry_path.write_text(json.dumps(registry), encoding="utf-8")
        damaged = registry_path.read_text(encoding="utf-8")
    
        receipt = None
        error = None
        try:
            receipt = prune_backups(paths, keep=1)
        except QuickScanBackupError as exc:
            error = exc.error_code
    
