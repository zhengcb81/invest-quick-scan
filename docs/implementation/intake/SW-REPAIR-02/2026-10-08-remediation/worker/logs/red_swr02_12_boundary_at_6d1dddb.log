kind = 'root'

    @pytest.mark.parametrize("kind", ["root", "parent"])
    def test_backup_root_and_parent_junction_never_write_beyond_the_workspace(
        tmp_path: Path, kind: str
    ) -> None:
        """SR02-2: a reparse point on the backup root or on its ``backups`` parent
        must be refused BEFORE any write — resolving first would hand the attacker's
        target the role of 'safe root'. list/prune on the same path must not delete
        the sentinel living outside the logical workspace either."""
        _winapi = pytest.importorskip(
            "_winapi", reason="real NTFS junction required; POSIX symlink is not accepted as proof"
        )
        fixture = tmp_path / "junction" / kind
        workspace = fixture / "workspace"
        foreign = fixture / "foreign"
        data = workspace / "data" / "quick_scan"
        data.mkdir(parents=True)
        (data / "marker.txt").write_text("owned fixture", encoding="utf-8")
        foreign.mkdir(parents=True)
        sentinel = foreign / "sentinel.txt"
        sentinel.write_text("foreign-to-workspace but test-owned", encoding="utf-8")
        if kind == "root":
            (workspace / "backups").mkdir(parents=True)
            link = workspace / "backups" / "quick_scan"
        else:
            link = workspace / "backups"
        _winapi.CreateJunction(str(foreign), str(link))
        assert link.is_dir(), "the fixture must be a real junction"
        paths = WorkspacePaths.from_root(workspace)
    
        error = None
        try:
            create_backup(paths, name="must_reject_junction_final")
        except QuickScanBackupError as exc:
            error = exc.error_code
>       assert error, "a workspace backup ancestor junction granted external write access"
E       AssertionError: a workspace backup ancestor junction granted external write access
