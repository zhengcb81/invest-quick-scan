        con = sqlite3.connect(db)
        con.execute("PRAGMA journal_mode=WAL")
        con.execute("PRAGMA wal_checkpoint=TRUNCATE")
        con.execute("BEGIN")
        con.execute(
            "INSERT INTO quick_scan_universe (universe_id, name, soft_target_capacity) "
            "VALUES ('UV_WAL', 'wal universe', NULL)"
