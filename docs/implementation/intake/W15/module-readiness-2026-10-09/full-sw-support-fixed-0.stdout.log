        workspace = fixture / "workspace"
        foreign = fixture / "foreign"
        data = workspace / "data" / "quick_scan"
        data.mkdir(parents=True)
        (data / "marker.txt").write_text("owned fixture", encoding="utf-8")
        foreign.mkdir(parents=True)
        sentinel = foreign / "sentinel.txt"
        sentinel.write_text("foreign-to-workspace but test-owned", encoding="utf-8")
        if kind == "root":
            (workspace / "backups").mkdir(parents=True)
            link = workspace / "backups" / "quick_scan"
