    def test_llm_chat_falls_back_on_auth_error(monkeypatch: pytest.MonkeyPatch) -> None:
        """When the first provider returns 401, the next provider is tried."""
        import urllib.error
        from io import BytesIO
    
        monkeypatch.setenv("MINIMAX_API_KEY", "minimax-key")
        monkeypatch.setenv("MIMO_API_KEY", "mimo-key")
    
        call_count = {"n": 0}
        providers_used: list[str] = []
    
        def mock_post(base_url, api_key, model, messages, **kwargs):
            call_count["n"] += 1
            if "minimaxi.com" in base_url:
                providers_used.append("minimax")
                resp = MagicMock()
                resp.read.return_value = b'{"error": "unauthorized"}'
                resp.code = 401
                raise urllib.error.HTTPError(base_url, 401, "Unauthorized", {}, BytesIO(b'{"error": "unauthorized"}'))
            providers_used.append("mimo")
            return _fake_response("fallback-ok")
    
        with patch("stockwiki.llm_provider._post_chat", side_effect=mock_post):
>           result = llm_chat(messages=[{"role": "user", "content": "hi"}])
