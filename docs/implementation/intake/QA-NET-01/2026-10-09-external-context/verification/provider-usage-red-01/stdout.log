        route = operation["context"]["route"]
        plan = operation["plan"]
        if (operation["budget_attempt_id"] != permit.attempt_id or operation["budget"]["status"] != "in_flight"
            or operation["context"]["search_policy_sha256"] != self.policy_sha256
            or route["route_id"] != self.route["route_id"] or route["provider"] != self.route["kind"]
            or route["endpoint"] != self.route["endpoint"] or route["adapter_version"] != ADAPTER_VERSION
            or plan["query"] != query or plan["top_k"] != top_k or plan["locale"] != locale):
            raise ValueError("external request binding does not match its frozen intent")
