+/* RESULT-TRUST-30 panel styles. Every selector is scoped to .rtp-root so the host page styles are not changed. */
+.rtp-root {
+  box-sizing: border-box;
+  max-width: 100%;
+  margin: 0.5rem 0;
+  padding: 0.75rem 0.875rem;
+  border: 1px solid #c9d3dd;
+  border-radius: 6px;
+  background: #ffffff;
+  color: #1d2733;
+  font: 14px/1.5 system-ui, -apple-system, "Segoe UI", "Microsoft YaHei", sans-serif;
+}
+.rtp-root *,
+.rtp-root *::before,
+.rtp-root *::after {
+  box-sizing: border-box;
+}
+.rtp-root.rtp-root--isolated {
+  border-style: dashed;
+  border-color: #b45309;
+}
+.rtp-root h3 {
+  margin: 0 0 0.25rem;
+  font-size: 1rem;
+  line-height: 1.4;
+}
+.rtp-root .rtp-identity {
+  margin: 0 0 0.5rem;
+  color: #334155;
+  overflow-wrap: anywhere;
+}
+.rtp-root .rtp-banner {
+  margin: 0 0 0.5rem;
+  padding: 0.375rem 0.5rem;
+  border-left: 4px solid #b45309;
+  background: #fff7ed;
+  color: #7c2d12;
+}
+.rtp-root .rtp-main,
+.rtp-root .rtp-detail {
+  display: grid;
+  gap: 0.375rem;
+  margin: 0;
+}
+.rtp-root .rtp-row {
+  display: grid;
+  grid-template-columns: minmax(7.5rem, 11rem) minmax(0, 1fr);
+  gap: 0.25rem 0.75rem;
+  align-items: start;
+}
+.rtp-root dt {
+  margin: 0;
+  font-weight: 600;
+  color: #334155;
+}
+.rtp-root dd {
+  margin: 0;
+  min-width: 0;
+  overflow-wrap: anywhere;
+}
+.rtp-root .rtp-value[data-rtp-state="missing"] {
+  color: #64748b;
+  font-style: italic;
+}
+.rtp-root .rtp-value[data-rtp-state="conflict"] {
+  color: #92400e;
+  font-weight: 600;
+}
+.rtp-root .rtp-value[data-rtp-state="unrecognized"] {
+  color: #6b21a8;
+}
+.rtp-root .rtp-value[data-rtp-state="isolated"] {
+  color: #64748b;
+}
+.rtp-root .rtp-parts,
+.rtp-root .rtp-variants {
+  margin: 0;
+  padding-left: 1.1rem;
+}
+.rtp-root .rtp-warnings {
+  margin: 0.5rem 0 0;
+  padding-left: 1.1rem;
+  color: #7c2d12;
+}
+.rtp-root details {
+  margin-top: 0.5rem;
+}
+.rtp-root summary {
+  cursor: pointer;
+  font-weight: 600;
+  color: #1e40af;
+}
+.rtp-root .rtp-refs {
+  margin: 0.375rem 0 0;
+  padding-left: 1.1rem;
+}
+.rtp-root .rtp-raw pre {
+  margin: 0.25rem 0 0;
+  padding: 0.5rem;
+  background: #f1f5f9;
+  white-space: pre-wrap;
+  overflow-wrap: anywhere;
+  font-size: 12px;
+}
+.rtp-root .rtp-actions {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 0.5rem;
+  margin-top: 0.625rem;
+}
+.rtp-root .rtp-view {
+  min-height: 36px;
+  padding: 0.375rem 0.75rem;
+  border: 1px solid #1e40af;
+  border-radius: 4px;
+  background: #1e40af;
+  color: #ffffff;
+  font: inherit;
+  cursor: pointer;
+}
+.rtp-root .rtp-view:disabled {
+  border-color: #94a3b8;
+  background: #e2e8f0;
+  color: #475569;
+  cursor: not-allowed;
+}
+.rtp-root .rtp-hint,
+.rtp-root .rtp-muted {
+  margin: 0;
+  color: #64748b;
+  font-size: 13px;
+}
+.rtp-root a {
+  color: #1d4ed8;
+  overflow-wrap: anywhere;
+}
+.rtp-root :focus-visible {
+  outline: 3px solid #2563eb;
+  outline-offset: 2px;
+}
+@media (max-width: 36rem) {
+  .rtp-root .rtp-row {
+    grid-template-columns: minmax(0, 1fr);
+    gap: 0.125rem;
+  }
+}
