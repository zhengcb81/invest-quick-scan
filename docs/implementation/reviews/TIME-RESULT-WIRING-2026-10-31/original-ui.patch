diff --git a/src/app/ui/result_trust_host.js b/src/app/ui/result_trust_host.js
new file mode 100644
index 0000000..e7cb2d7
--- /dev/null
+++ b/src/app/ui/result_trust_host.js
@@ -0,0 +1,57 @@
+// Read-only host integration. Actual envelopes supply identity; URLs never do.
+import {projectEntity} from '../vendor/compare/compare_view.js';
+import {describeResultTrust} from '../vendor/result-trust/result_trust_panel.js';
+export const COMPANY_VIEW_PROTOCOL='iqs.company_research_view/1.0.0';
+const object=v=>v!==null&&typeof v==='object'&&!Array.isArray(v);
+
+export async function loadCompanyView(request,id) {
+  try {
+    const view=await request(`entity-view?id=${encodeURIComponent(id)}`);
+    if(!object(view)||view.protocol!==COMPANY_VIEW_PROTOCOL||!object(view.entity))
+      throw Object.assign(new Error('公司结果视图协议不匹配，请重新连接服务。'),{code:'company_view_contract'});
+    return view;
+  } catch(error) {
+    // Capability downgrade is explicit; a timeout/identity error never triggers a second read.
+    if(error.code!=='method_or_route_not_allowed')throw error;
+    return {protocol:'legacy_entity_fallback',entity:await request(`entity?id=${encodeURIComponent(id)}`),temporal_shadow:null};
+  }
+}
+
+export function resultDetailModel(detail,requestedId) {
+  const projected=projectEntity(detail,{entityId:requestedId});
+  const conflict=projected.issues.some(x=>x.code==='entity_envelope_identity_conflict');
+  const originalRows=Array.isArray(detail?.groups)
+    ?detail.groups.flatMap(g=>Array.isArray(g?.fields)?g.fields:[])
+    :Array.isArray(detail?.rows)?detail.rows:[];
+  const rows=[],isolated=[];
+  const ownerState={entity_id:projected.entity_id,envelope_identity_conflict:conflict};
+  for(const key of ['generated_at_utc','quality','gaps','score_summary','recovery','runtime','projection','ack','research'])
+    if(Object.hasOwn(detail||{},key))ownerState[key]=detail[key];
+  if(object(projected.entity)&&Object.hasOwn(projected.entity,'identity_state'))ownerState.identity_state=projected.entity.identity_state;
+  for(const raw of originalRows) {
+    if(!object(raw)){isolated.push(raw);continue;}
+    const identity=describeResultTrust({record:raw,ownerState}).items.find(i=>i.key==='identity')?.identity_state;
+    if(conflict||['foreign','invalid_child_identity','envelope_conflict'].includes(identity))isolated.push(raw);
+    else rows.push(raw);
+  }
+  return {rows,isolated,originalRows,ownerState,issues:projected.issues,entity:projected.entity};
+}
+
+export function recordOwnerState(model,row) {
+  return {...model.ownerState,field_observations:model.originalRows.filter(v=>object(v)
+    && ((row.field_id&&v.field_id===row.field_id)||(row.question_id&&v.question_id===row.question_id)))};
+}
+
+const KINDS={market_sensitive:'行情敏感',periodic_financial:'定期财务',structural:'长期经营特征',event_sensitive:'事件敏感',mixed:'多类信息'};
+export function temporalRecordText(shadow,row) {
+  if(!object(shadow)||shadow.protocol!=='iqs.temporal_shadow/1.0.0'
+     ||shadow.mode!=='read_only_shadow'||shadow.production_reuse_applied!==false||shadow.reuse_authorized!==false)
+    return '时点解释未提供；资料新旧以原服务预检为准。';
+  const matches=Array.isArray(shadow.records)?shadow.records.filter(v=>v?.observation_id===row.observation_id
+    &&v.question_id===row.question_id&&v.field_id===row.field_id):[];
+  if(matches.length!==1)return '该原观察缺少唯一时点解释；实际复用以原服务预检为准。';
+  const item=matches[0],assessment=item.captured_context_assessment||item.clock_only_assessment;
+  const clocks=(assessment?.clock_assessments||[]).map(v=>({fact_valid_clock:'答案执行时点',market_clock:'行情时点',
+    reporting_period_clock:'财务期间',publication_clock:'来源发布时间',verification_clock:'独立核查时点'}[v.clock]||v.clock));
+  return `信息类型：${KINDS[item.knowledge_kind]||'尚未绑定当前题义'}。${clocks.length?`分别检查：${clocks.join('、')}。`:''}当前路由未核验，未授予复用；缺少独立核查凭证时不自动续期。`;
+}
