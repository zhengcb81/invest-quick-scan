+
+export function renderResultTrustPanel({ record, ownerState, onViewOriginal } = {}) {
+  if (!globalThis.document) throw new Error('renderResultTrustPanel needs a DOM document');
+  const model = describeResultTrust({ record, ownerState });
+  const byKey = Object.fromEntries(model.items.map(entry => [entry.key, entry]));
+  const identityState = byKey.identity ? byKey.identity.identity_state : 'unknown';
+  const isolated = identityState === 'foreign' || identityState === 'envelope_conflict';
+  panelSequence += 1;
+  const titleId = `rtp-title-${panelSequence}`;
+  const hintId = `rtp-hint-${panelSequence}`;
+  const primary = model.original_refs.find(ref => ref.kind === 'observation')
+    ?? model.original_refs.find(ref => ref.kind === 'entity') ?? null;
+  // The interface disables the callback only when a reference is missing. Identity isolation keeps
+  // the three ambiguous-attribution states disabled as well; the rule is documented in the map guards.
+  const isolatedForView = identityState === 'foreign' || identityState === 'envelope_conflict'
+    || identityState === 'invalid_child_identity';
+  const canView = typeof onViewOriginal === 'function' && primary !== null && !isolatedForView;
+  const hintText = primary !== null && isolatedForView
+    ? '此记录归属未确认或属于其他实体，按钮暂不可用；请以原记录为准。'
+    : '没有可用的原记录引用，或宿主未提供只读回调，按钮暂不可用。';
+  const hasItems = model.items.length > 0;
+  const button = h('button', {
+    type: 'button',
+    class: 'rtp-view',
+    'data-rtp-action': 'view-original',
+    disabled: !canView,
+    'aria-describedby': canView ? null : hintId,
+    text: '查看原记录（只读）',
+  });
+  if (canView) {
+    button.addEventListener('click', () => onViewOriginal({ kind: primary.kind, id: primary.id }));
+  }
+  return h('section', {
+    class: isolated ? 'rtp-root rtp-root--isolated' : 'rtp-root',
+    'aria-labelledby': titleId,
+    'data-rtp-identity': identityState,
+  }, [
+    h('div', { class: 'rtp-head' }, [
+      h('h3', { id: titleId, text: '结果可信信息' }),
+      hasItems ? h('p', { class: 'rtp-identity', text: `归属：${byKey.identity.text}` }) : null,
+      isolated ? h('p', { class: 'rtp-banner', text: '隔离显示：这不是当前公司已确认的结果，不计入本公司汇总。' }) : null,
+    ]),
+    hasItems ? h('dl', { class: 'rtp-main', 'aria-label': '主要可信信息' }, MAIN_ORDER.slice(1).map(key => valueRow(byKey[key]))) : null,
+    model.warnings.length
+      ? h('ul', { class: 'rtp-warnings', 'aria-label': '需要注意的提示' }, model.warnings.map(warning => h('li', { 'data-rtp-warning': warning.code, text: warning.text })))
+      : null,
+    hasItems ? h('details', { class: 'rtp-details' }, [
+      h('summary', { text: '展开：模型、范围、题义、原始引用与缺口' }),
+      h('dl', { class: 'rtp-detail' }, RESULT_TRUST_ITEM_KEYS
+        .filter(key => !MAIN_KEYS.has(key) && key !== 'raw_codes')
+        .map(key => valueRow(byKey[key]))),
+      refsList(model.original_refs),
+      h('details', { class: 'rtp-raw' }, [
+        h('summary', { text: '原诊断码（只读）' }),
+        h('pre', { text: byKey.raw_codes.text }),
+      ]),
+    ]) : null,
+    h('div', { class: 'rtp-actions' }, [
+      button,
+      canView ? null : h('p', { class: 'rtp-hint', id: hintId, text: hintText }),
+    ]),
+  ]);
+}
