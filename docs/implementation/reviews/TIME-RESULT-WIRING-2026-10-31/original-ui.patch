+// The caller passes owner values. This module reads them, returns new objects, never writes into its inputs,
+// never requests data, never scores, never judges freshness from a clock, and never grants a permission.
+
+export const RESULT_TRUST_PROTOCOL = 'iqs.result_trust_view/1.0.0';
+
+export const RESULT_TRUST_ITEM_KEYS = [
