+"""Node host tests use synthetic DTOs and no network."""
+from pathlib import Path
+import os,shutil,subprocess,unittest
+
+ROOT=Path(__file__).resolve().parents[1]
+class ResultTrustHostTests(unittest.TestCase):
+    def test_actual_host_contracts(self):
+        node=shutil.which('node')
+        if not node:self.skipTest('Node runtime unavailable')
+        env={k:v for k,v in os.environ.items() if not any(s in k.upper() for s in ('API_KEY','TOKEN','SECRET','PASSWORD'))}
+        result=subprocess.run([node,'--test','--test-concurrency=1',str(ROOT/'tests/js/result_trust_host.mjs')],cwd=ROOT,env=env,capture_output=True,text=True,encoding='utf-8',timeout=30)
+        self.assertEqual(result.returncode,0,result.stdout+result.stderr)
