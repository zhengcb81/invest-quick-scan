new file mode 100644
index 0000000..72e0d2a
--- /dev/null
+++ b/tests/test_controller_integrity.py
@@ -0,0 +1,99 @@
+import copy
+import json
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+import iqs_answer_audit as audit
+from conftest import CONTENT, LAB, PRIVATE, EXPECTED_PRIVATE_SHA256
+
+
+@pytest.fixture
+def corpus(tmp_path):
+    target = tmp_path / 'content'
+    shutil.copytree(CONTENT, target)
+    return target
+
+
+def edit(path, fn):
+    data = json.loads(path.read_text(encoding='utf-8'))
+    fn(data)
+    path.write_text(json.dumps(data, ensure_ascii=False), encoding='utf-8')
+
+
+@pytest.mark.parametrize('field', ['question_id','question_version','question_definition_sha256','module_release_id','information_cutoff','information_as_of'])
+def test_reject_binding_drift(corpus, field):
+    edit(corpus/'sample-verdicts.json', lambda d: d['rows'][0].__setitem__(field,'wrong'))
+    samples = audit.load_private_samples(PRIVATE, EXPECTED_PRIVATE_SHA256)
+    with pytest.raises(audit.AuditIntegrityError):
+        audit.validate_chain(corpus, samples)
+
+
+def test_coverage_cannot_redistribute_verdicts_preserving_total(corpus):
+    def corrupt(d):
+        f=d['rows']['factual_support']
+        f['supported'] += 1
+        f['partially_supported'] -= 1
+        n=f['supported']+f['partially_supported']+f['contradicted']
+        f['supported_share_of_assessable']=round(f['supported']/n,4)
+    edit(corpus/'coverage.json',corrupt)
+    with pytest.raises(audit.AuditIntegrityError):
+        audit.validate_chain(corpus,audit.load_private_samples(PRIVATE,EXPECTED_PRIVATE_SHA256))
+
+
+def test_source_reverse_claim_link_cannot_disappear(corpus):
+    edit(corpus/'sources.json',lambda d:d['rows'][0].__setitem__('used_by_claims',[]))
+    with pytest.raises(audit.AuditIntegrityError):
+        audit.validate_chain(corpus,audit.load_private_samples(PRIVATE,EXPECTED_PRIVATE_SHA256))
+
+
+def test_pointer_url_is_bound_to_original(corpus):
+    edit(corpus/'claims.json',lambda d:d['rows'][0]['original_pointer'].__setitem__('url','https://wrong.example/'))
+    with pytest.raises(audit.AuditIntegrityError):
+        audit.validate_chain(corpus,audit.load_private_samples(PRIVATE,EXPECTED_PRIVATE_SHA256))
+
+
+def test_shared_lock_must_match(corpus):
+    edit(corpus/'sources.json',lambda d:d.__setitem__('input_lock_sha256','0'*64))
+    with pytest.raises(audit.AuditIntegrityError):
+        audit.validate_chain(corpus,audit.load_private_samples(PRIVATE,EXPECTED_PRIVATE_SHA256))
+
+
+@pytest.mark.parametrize('field', ['entity','security_scope'])
+def test_claim_subject_must_match_frozen_observation(corpus,field):
+    edit(corpus/'claims.json',lambda d:d['rows'][0].__setitem__(field,'FOREIGN'))
+    with pytest.raises(audit.AuditIntegrityError):
+        audit.validate_chain(corpus,audit.load_private_samples(PRIVATE,EXPECTED_PRIVATE_SHA256))
+
+@pytest.mark.parametrize('field', ['period','currency','unit'])
+def test_claim_numeric_metadata_remains_original(corpus,field):
+    edit(corpus/'claims.json',lambda d:d['rows'][0].__setitem__(field,{'end':'1900-01-01'} if field=='period' else 'CNY'))
+    with pytest.raises(audit.AuditIntegrityError):
+        audit.validate_chain(corpus,audit.load_private_samples(PRIVATE,EXPECTED_PRIVATE_SHA256))
+
+def test_output_completeness_is_recomputed_from_original(corpus):
+    def corrupt(d):
+        d['rows']['model_output_completeness']['scored_samples']+=1
+        d['rows']['model_output_completeness']['refusal_samples']-=1
+    edit(corpus/'coverage.json',corrupt)
+    with pytest.raises(audit.AuditIntegrityError):
+        audit.validate_chain(corpus,audit.load_private_samples(PRIVATE,EXPECTED_PRIVATE_SHA256))
+
+
+def test_material_claims_cannot_be_silently_dropped(corpus):
+    edit(corpus/'sample-verdicts.json',lambda d:d['rows'][0].__setitem__('material_claim_ids',[]))
+    with pytest.raises(audit.AuditIntegrityError):
+        audit.validate_chain(corpus,audit.load_private_samples(PRIVATE,EXPECTED_PRIVATE_SHA256))
+
+
+def test_public_builder_rejects_mutated_private_before_output(tmp_path):
+    target=tmp_path/'lab'
+    for directory in ['audit','src','vendor_upstream']:
+        shutil.copytree(LAB/directory,target/directory)
+    (target/'.private-inputs').mkdir()
+    (target/'.private-inputs/live-answers-32.json').write_bytes(PRIVATE.read_bytes()+b'\n')
+    p=subprocess.run([sys.executable,'-B',str(target/'audit/build_content.py')],cwd=target,capture_output=True,text=True)
+    assert p.returncode != 0, 'tampered corpus was stamped input_lock_sha256_verified=true'
+    assert not (target/'content').exists(), 'must validate before creating deliverables'
