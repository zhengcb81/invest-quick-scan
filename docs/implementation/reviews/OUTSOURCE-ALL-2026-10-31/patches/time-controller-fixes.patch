diff --git a/tests/e2e/test_acceptance_named_refusals.py b/tests/e2e/test_acceptance_named_refusals.py
new file mode 100644
index 0000000..8ad5aa0
--- /dev/null
+++ b/tests/e2e/test_acceptance_named_refusals.py
@@ -0,0 +1,19 @@
+"""The public CLI must keep malformed JSON values as named refusals."""
+import json
+import pytest
+from tests.e2e.test_cli import _run_cli, _catalog_path, _fixture_context, _fixture_obs
+
+@pytest.mark.parametrize('change,code',[
+    ({'observed_at':'2026-99-99T09:00:00Z'},'timestamp_not_utc'),
+    ({'answer':{'evidence':[None]}},'evidence_invalid'),
+])
+def test_malformed_observation_refusal_is_json_without_output(tmp_path,change,code):
+    obs=_fixture_obs(tmp_path,**change)
+    original=obs.read_bytes()
+    out=tmp_path/'out.json'
+    proc=_run_cli('assess','--observation',str(obs),'--policy-catalog',str(_catalog_path()),
+        '--question-id','IQS_24','--policy','legacy-min-ttl/1.0.0','--now','2026-10-30T12:00:00Z',
+        '--cutoff','2026-10-30','--context',str(_fixture_context(tmp_path)),'--out',str(out))
+    assert proc.returncode==2
+    assert json.loads(proc.stderr)['error']==code
+    assert not out.exists() and obs.read_bytes()==original
diff --git a/tests/unit/test_acceptance_boundaries.py b/tests/unit/test_acceptance_boundaries.py
new file mode 100644
index 0000000..aa592b1
--- /dev/null
+++ b/tests/unit/test_acceptance_boundaries.py
@@ -0,0 +1,89 @@
+"""Controller regressions: synthetic candidates, never production qualification."""
+import copy
+import pytest
+
+from iqs_time_semantics.assess import assess_reuse
+from iqs_time_semantics.errors import TimeSemanticsError
+from tests.unit.helpers import (
+    observation, context, question_policy_structural, with_candidate_selection,
+    valid_receipt, accept_all_verifier, NOW_DEFAULT, CUTOFF_DEFAULT,
+)
+
+def call(*, obs=None, receipt=None, required=None):
+    entry=question_policy_structural('IQS_24','score.iqs_24')
+    if required is not None:
+        entry['required_clocks']=required
+    policy=with_candidate_selection(entry, verification_clock={'max_age_hours':24})
+    return assess_reuse(
+        obs or observation(answer={'information_as_of':'2026-10-30T09:00:00Z'}),
+        policy, now_utc=NOW_DEFAULT, information_cutoff=CUTOFF_DEFAULT,
+        context=context(), verification_verifier=accept_all_verifier(receipt),
+    )
+
+def test_bound_valid_receipt_stays_candidate_only():
+    r=call(receipt=valid_receipt())
+    assert r['decision']=='reuse_candidate'
+    assert r['candidate_only'] is True and r['production_ready'] is False
+
+@pytest.mark.parametrize('change',[
+    {'policy_version':'wrong/9'},
+    {'policy_version':None},
+    {'coverage':{'searched_at':'2020-01-01T00:00:00Z','sources_checked':['https://example.com'],'search_executed':True,'search_receipt_id':'synthetic','cutoff':'2020-01-01'}},
+    {'coverage':{'searched_at':'2026-10-30T09:00:00Z','sources_checked':['https://example.com'],'search_executed':True,'search_receipt_id':'synthetic','cutoff':CUTOFF_DEFAULT}},
+    {'coverage':{'searched_at':None,'sources_checked':['https://example.com'],'search_executed':True,'search_receipt_id':'synthetic','cutoff':CUTOFF_DEFAULT}},
+    {'coverage':{'searched_at':'2026-10-30T07:30:00Z','sources_checked':[],'search_executed':True,'search_receipt_id':'synthetic','cutoff':CUTOFF_DEFAULT}},
+    {'coverage':{'searched_at':'2026-10-30T07:30:00Z','sources_checked':['https://example.com'],'search_executed':True,'search_receipt_id':True,'cutoff':CUTOFF_DEFAULT}},
+    {'expires_at':True},
+])
+def test_misbound_or_incomplete_receipt_never_renews(change):
+    r=call(receipt=valid_receipt(**change))
+    assert r['decision']!='reuse_candidate'
+    assert r['actual_source_dates']['verified_at'] is None
+    assert r['actual_source_dates']['searched_at'] is None
+
+@pytest.mark.parametrize('change',[
+    {'security_id':'SEC_FOREIGN'},
+    {'security_id':None},
+    {'scope':'entity','scope_id':'ENT_FOREIGN'},
+])
+def test_conflicting_canonical_subject_is_named_refusal(change):
+    with pytest.raises(TimeSemanticsError):
+        call(obs=observation(**change))
+
+@pytest.mark.parametrize('change',[
+    {'observed_at':'2026-99-99T09:00:00Z'},
+    {'answer':{'evidence':[None]}},
+    {'answer':{'evidence':[True]}},
+    {'answer':{'evidence':['not-an-object']}},
+])
+def test_malformed_input_is_named_refusal_not_runtime_crash(change):
+    with pytest.raises(TimeSemanticsError):
+        call(obs=observation(**change))
+
+def test_missing_citations_cannot_satisfy_publication_gate():
+    r=call(obs=observation(answer={'evidence':[]}))
+    assert r['decision']!='reuse_candidate'
+    assert 'publication_missing' in r['reason_codes']
+
+def test_inputs_unchanged_after_receipt_rejection():
+    obs=observation(); receipt=valid_receipt(policy_version='wrong/9')
+    before=copy.deepcopy((obs,receipt))
+    call(obs=obs,receipt=receipt)
+    assert (obs,receipt)==before
+
+def test_cutoff_day_includes_last_fractional_second():
+    obs=observation(answer={'evidence':[{'published_at':'2026-10-30T23:59:59.999999Z'}]})
+    policy=with_candidate_selection(question_policy_structural('IQS_24','score.iqs_24'))
+    r=assess_reuse(obs,policy,now_utc='2026-10-31T00:00:00Z',information_cutoff=CUTOFF_DEFAULT,context=context())
+    assert 'evidence_published_after_cutoff' not in r['reason_codes']
+
+def test_source_publication_after_actual_now_cannot_pass():
+    obs=observation(answer={'evidence':[{'published_at':'2026-10-30T23:00:00Z'}]})
+    r=call(obs=obs)
+    assert r['decision']!='reuse_candidate'
+    assert 'evidence_published_in_future' in r['reason_codes']
+
+@pytest.mark.parametrize('value',[True,False,123,{},[]])
+def test_malformed_source_retraction_is_never_silently_ignored(value):
+    with pytest.raises(TimeSemanticsError):
+        call(obs=observation(answer={'evidence':[{'published_at':'2026-10-29','retracted_at':value}]}))
