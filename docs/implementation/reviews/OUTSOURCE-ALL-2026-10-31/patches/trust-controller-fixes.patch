diff --git a/tests/browser/test_review_regressions.py b/tests/browser/test_review_regressions.py
new file mode 100644
index 0000000..fd65c21
--- /dev/null
+++ b/tests/browser/test_review_regressions.py
@@ -0,0 +1,18 @@
+"""Reviewer regression: mixed-entity same-question variants remain visibly isolated."""
+def test_mixed_variant_identity_and_malformed_date_in_real_browser(page, loopback_server):
+    page.goto(f'{loopback_server}/demo/index.html')
+    text = page.evaluate("""async () => {
+      const {renderResultTrustPanel}=await import('/src/result_trust_panel.js');
+      const record={entity_id:'entity_A',observation_id:'obs_A',question_id:'IQS_01',score:7,status:'scored',information_as_of:'2026-99-99'};
+      const ownerState={entity_id:'entity_A',field_observations:[record,{...record,entity_id:'entity_B',observation_id:'obs_B',score:9,listing_id:'US_A',scope:'security'}]};
+      const panel=renderResultTrustPanel({record,ownerState});
+      document.getElementById('panel-host').replaceChildren(panel);
+      panel.querySelector('details.rtp-details').open=true;
+      return {text:panel.textContent,dateState:panel.querySelector('[data-rtp-key="information_as_of"] dd').dataset.rtpState,variantState:panel.querySelector('[data-rtp-key="field_variants"] dd').dataset.rtpState};
+    }""")
+    assert 'entity_B' in text['text'] and '已隔离显示' in text['text']
+    assert 'US_A' in text['text'] and 'security' in text['text']
+    assert text['dateState']=='unrecognized' and text['variantState']=='conflict'
+    page.set_viewport_size({'width':390,'height':844})
+    assert page.evaluate('document.documentElement.scrollWidth <= window.innerWidth')
+    assert page.blocked_requests==[]
diff --git a/tests/unit/review-regressions.test.mjs b/tests/unit/review-regressions.test.mjs
new file mode 100644
index 0000000..349bd1a
--- /dev/null
+++ b/tests/unit/review-regressions.test.mjs
@@ -0,0 +1,55 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+const { describeResultTrust } = await import('../../src/result_trust_panel.js');
+const base = {entity_id:'entity_A',observation_id:'obs_A',question_id:'IQS_01',score:7,status:'scored',information_as_of:'2026-10-30'};
+const item=(record,ownerState,key)=>describeResultTrust({record,ownerState}).items.find(x=>x.key===key);
+for (const [observed,imported,expected] of [
+ ['2026-10-30T10:00:00.1Z','2026-10-30T10:00:00.10Z',false],
+ ['2026-10-30T10:00:00.1Z','2026-10-30T10:00:00Z',true],
+ ['2026-10-30T10:00:00+00:00','2026-10-30T09:30:00Z',true],
+ ['2026-10-30T10:00:00.000000002Z','2026-10-30T10:00:00.000000001Z',true],
+]) test(`UTC chronology preserves offset and fraction: ${observed}/${imported}`,()=>{
+ const warnings=describeResultTrust({record:{...base,observed_at:observed,imported_at:imported},ownerState:{entity_id:'entity_A'}}).warnings.map(x=>x.code);
+ assert.equal(warnings.includes('observed_after_imported'),expected);
+});
+for(const [info,expected] of [['2026-10-31T00:30:00+02:00',false],['2026-10-30T23:30:00-02:00',true]]) {
+ test(`UTC cutoff day: ${info}`,()=>{
+  const warnings=describeResultTrust({record:{...base,information_as_of:info,information_cutoff:'2026-10-30'},ownerState:{entity_id:'entity_A'}}).warnings.map(x=>x.code);
+  assert.equal(warnings.includes('information_after_cutoff'),expected);
+ });
+}
+for(const value of ['2026-10-30T99:99:99Z','2026-10-30T23:60:00Z','2026-10-30T23:59:60Z','2026-10-30T12:00:00+24:00','2026-10-30T12:00:00+01:60']) {
+ test(`invalid time components remain unrecognized: ${value}`,()=>{
+   assert.equal(item({...base,information_as_of:value},{entity_id:'entity_A'},'information_as_of').state,'unrecognized');
+ });
+}
+test('a foreign same-question variant is explicitly isolated and not called the current entity',()=>{
+ const variant={...base,entity_id:'entity_B',observation_id:'obs_B',score:9};
+ const result=item(base,{entity_id:'entity_A',field_observations:[base,variant]},'field_variants');
+ assert.equal(result.state,'conflict');assert.equal(result.variants[1].identity_state,'foreign');assert.match(result.text,/隔离/);assert.match(result.text,/entity_B/);
+});
+test('explicit null variant identity remains unknown while absent key may inherit the real envelope',()=>{
+ const missing={...base};delete missing.entity_id;
+ const result=item(base,{entity_id:'entity_A',field_observations:[{...base,entity_id:null},missing]},'field_variants');
+ assert.equal(result.variants[0].identity_state,'child_unknown');assert.equal(result.variants[1].identity_state,'inherited');
+});
+test('malformed variant identity is marked unrecognized instead of inheriting the envelope',()=>{
+ const result=item(base,{entity_id:'entity_A',field_observations:[{...base,entity_id:42}]},'field_variants');
+ assert.equal(result.state,'conflict');assert.equal(result.variants[0].identity_state,'invalid_child_identity');
+});
+test('an array containing only unreadable variants reports the unreadable count',()=>{
+ const result=item(base,{entity_id:'entity_A',field_observations:[null,1,false]},'field_variants');
+ assert.equal(result.state,'unrecognized');assert.match(result.text,/3/);assert.doesNotMatch(result.text,/无同题其他原观察/);
+});
+test('variant listing and scope differences remain visible alongside original values',()=>{
+ const result=item(base,{entity_id:'entity_A',field_observations:[{...base,listing_id:'HK_A',scope:'security'},{...base,listing_id:'US_A',scope:'entity'}]},'field_variants');
+ assert.match(result.text,/HK_A/);assert.match(result.text,/US_A/);assert.match(result.text,/security/);assert.match(result.text,/entity/);
+});
+for (const value of ['2026-99-99','2025-02-29','2026-04-31','0000-01-01']) test(`invalid calendar ${value} retains text without claiming recognized precision`,()=>{
+ const result=item({...base,information_as_of:value},{entity_id:'entity_A'},'information_as_of');
+ assert.equal(result.state,'unrecognized');assert.ok(result.text.includes(value));
+});
+test('a leap day is recognized without reading a clock or changing its value',()=>{
+ const result=item({...base,information_as_of:'2024-02-29'},{entity_id:'entity_A'},'information_as_of');
+ assert.equal(result.state,'present');assert.match(result.text,/2024-02-29/);
+});
