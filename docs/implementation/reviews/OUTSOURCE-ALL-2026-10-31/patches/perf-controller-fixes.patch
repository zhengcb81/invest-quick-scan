index 7aae780..e6dba21 100644
--- a/tools/build_handoff.py
+++ b/tools/build_handoff.py
@@ -35,11 +35,49 @@ def sha(path: Path) -> str:
     return hashlib.sha256(path.read_bytes()).hexdigest()
 
 
+def load_test_evidence(path: Path) -> list[dict]:
+    """Use recorded executions, never hard-coded test counts or generation time.
+
+    The recorder owns the actual execution. A matching file hash supports
+    provenance, not a claim that software checks prove financial accuracy.
+    """
+    data = json.loads(path.read_text(encoding="utf-8"))
+    rows = data.get("commands")
+    if not isinstance(rows, list) or {row.get("name") for row in rows} != {"unit", "integration", "e2e"} or len(rows) != 3:
+        raise ValueError("test evidence must contain exactly unit/integration/e2e")
+    for row in rows:
+        for field in ("passed", "failed", "skipped"):
+            if type(row.get(field)) is not int or row[field] < 0:
+                raise ValueError("test evidence count must be a nonnegative integer")
+        if type(row.get("exit_code")) is not int or row["exit_code"] != 0 or row["failed"] or not row["passed"]:
+            raise ValueError("test evidence contains failed or empty execution")
+        if not isinstance(row.get("argv"), list) or not row["argv"] or not row.get("cwd") or not row.get("utc"):
+            raise ValueError("test evidence needs real argv/cwd/UTC")
+        log = Path(row.get("log", ""))
+        if not log.is_absolute():
+            log = path.parent / log
+        if not log.is_file() or sha(log) != row.get("log_sha256"):
+            raise ValueError("test evidence log hash mismatch")
+    return rows
+
+
