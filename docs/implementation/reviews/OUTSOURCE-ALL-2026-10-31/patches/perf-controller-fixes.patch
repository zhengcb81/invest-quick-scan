@@ -0,0 +1,80 @@
+"""Real frozen owner guards after single/batched preview; SQLite is synthetic.
+
+These extend (not replace) the original importer unit checks. Each variant
+reopens bundle files and the native receiver through its actual worker code.
+No model/search/provider calls or foreign database are involved.
+"""
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import subprocess
+import sys
+import pytest
+
+LAB = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(LAB / 'src'))
+from iqs_import_perf import fixtures
+
+@pytest.fixture(scope='module')
+def owner_variants(tmp_path_factory):
+    prepared = {}
+    for variant in ('baseline', 'candidate'):
+        target = tmp_path_factory.mktemp('guard-' + variant) / 'v'
+        argv = [sys.executable, '-B', str(LAB/'tools/prepare_variant.py'), '--target', str(target)]
+        if variant == 'candidate':
+            argv += ['--patch', str(LAB/'integration/candidate.patch')]
+        subprocess.run(argv, cwd=LAB, check=True)
+        spec = importlib.util.spec_from_file_location('owner_guard_' + variant, target/'iqs/scripts/dashboard_owner.py')
+        owner = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(owner)
+        prepared[variant] = (target, owner)
+    return prepared
+
+@pytest.fixture(scope='module')
+def one_sealed_packet(tmp_path_factory):
+    return fixtures.build_stockqa_ledger(tmp_path_factory.mktemp('guard-ledger')/'work.sqlite', fixtures.question_plan(1))
+
+@pytest.mark.parametrize('variant', ['baseline', 'candidate'])
+@pytest.mark.parametrize('scenario', ['package_tampered', 'release_tampered', 'stale_token', 'exact_replay'])
+def test_real_owner_revalidates_after_preview(owner_variants, one_sealed_packet, tmp_path, variant, scenario):
+    target, owner = owner_variants[variant]
+    ws = fixtures.build_stockwiki_workspace(tmp_path/'workspace')
+    item = one_sealed_packet['sealed'][0]
+    delivery = one_sealed_packet['store'].get_result_delivery(item['work_item_id'])
+    package = tmp_path/'package.json'; package.write_text(delivery['package_json'], encoding='utf8')
+    release = tmp_path/'release.json'; release.write_text(json.dumps(fixtures.release_projection()), encoding='utf8')
+    scratch = tmp_path/'scratch'; scratch.mkdir()
+    config = {'stockwiki_root': str(target/'stockwiki'), 'iqs_root': str(target/'iqs'),
+              'iqs_release_root': str(target/'iqs'), 'workspace_root': str(tmp_path/'workspace'),
+              'scratch_root': str(scratch), 'stockwiki_python': sys.executable, 'timeout_seconds': 120,
+              'bundles': {'one': {'package': str(package), 'release': str(release),
+                                  'package_sha256': hashlib.sha256(package.read_bytes()).hexdigest(),
+                                  'release_sha256': hashlib.sha256(release.read_bytes()).hexdigest()}}}
+    if variant == 'candidate':
+        rows = owner._owner_worker(config, 'operations', {'operations': [
+            {'operation':'import_preview','payload':{'bundle_id':'one'}}, {'operation':'status'}]})
+        preview = owner.OwnerGateway.unwrap_batch(rows[0])
+        status = owner.OwnerGateway.unwrap_batch(rows[1], swallow_owner_errors=True)
+    else:
+        preview = owner._owner_worker(config, 'import_preview', {'bundle_id':'one'})
+        status = owner._owner_worker(config, 'status', {})
+    assert preview['can_apply'] and status['available']
+    body = {'bundle_id':'one','preview_token':preview['preview_token']}
+    if scenario in {'package_tampered','release_tampered'}:
+        path = package if scenario == 'package_tampered' else release
+        path.write_bytes(path.read_bytes() + b' ')
+    if scenario == 'stale_token':
+        body['preview_token'] = 'not-the-current-token'
+    if scenario != 'exact_replay':
+        with pytest.raises(owner.DashboardOwnerError) as error:
+            owner._owner_worker(config, 'import_apply', body)
+        assert error.value.code == ('preview_stale' if scenario == 'stale_token' else 'bundle_hash_mismatch')
+        import sqlite3
+        with sqlite3.connect(ws['receiver'].database_path) as connection:
+            assert connection.execute('SELECT COUNT(*) FROM quick_scan_observation').fetchone()[0] == 0
+    else:
+        first = owner._owner_worker(config, 'import_apply', body)
+        second = owner._owner_worker(config, 'import_apply', body)
+        assert first['receipt']['acks'] == second['receipt']['acks']
+        assert first['receipt']['summary'] == {'accepted':1}
