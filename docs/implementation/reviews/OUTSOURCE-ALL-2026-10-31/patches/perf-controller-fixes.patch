new file mode 100644
index 0000000..4cdf6d9
--- /dev/null
+++ b/tests/unit/test_execution_evidence.py
@@ -0,0 +1,72 @@
+"""Regression for failed-child cleanup and evidence-derived metadata counts."""
+import importlib.util
+import json
+from pathlib import Path
+import subprocess
+import sys
+import pytest
+
+LAB = Path(__file__).resolve().parents[2]
+
+def module(name, path):
+    spec = importlib.util.spec_from_file_location(name, LAB / path)
+    result = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(result)
+    return result
+
+
+def test_matrix_child_failure_cleans_its_entire_variant_root(tmp_path, monkeypatch):
+    driver = module('perf_driver_cleanup', 'bench/run_benchmark.py')
+    monkeypatch.setattr(driver, 'LAB_ROOT', tmp_path)
+    monkeypatch.setattr(sys, 'argv', ['run_benchmark.py', '--packets', '1', '--variants', 'baseline', '--bench-id', 'failure'])
+    def run(argv, **kwargs):
+        if 'prepare_variant.py' in str(argv):
+            target = Path(argv[argv.index('--target') + 1])
+            target.mkdir(parents=True)
+            (target / 'synthetic.sqlite').write_text('synthetic temporary bytes')
+        return subprocess.CompletedProcess(argv, 0, stdout='0' * 40, stderr='')
+    monkeypatch.setattr(driver.subprocess, 'run', run)
+    def child_failure(*args, **kwargs):
+        raise RuntimeError('injected child failure after variant preparation')
+    monkeypatch.setattr(driver, 'run_invocation', child_failure)
+    with pytest.raises(RuntimeError, match='injected child failure'):
+        driver.main()
+    assert not (tmp_path / '.tmp' / 'failure').exists()
+
+
+def test_metadata_counts_come_from_actual_suite_evidence(tmp_path):
+    builder = module('perf_metadata_evidence', 'tools/build_handoff.py')
+    rows = []
+    for name, count in [('unit', 17), ('integration', 8), ('e2e', 6)]:
+        log = tmp_path / (name + '.log')
+        log.write_text(f'{count} passed')
+        rows.append({'name': name, 'argv': ['python', '-m', 'pytest', 'tests/' + name],
+                     'cwd': str(tmp_path), 'utc': '2026-10-31T00:00:00Z', 'exit_code': 0,
+                     'passed': count, 'failed': 0, 'skipped': 0, 'log': str(log),
+                     'log_sha256': builder.sha(log)})
+    evidence = tmp_path / 'evidence.json'
+    evidence.write_text(json.dumps({'commands': rows}))
+    got = builder.load_test_evidence(evidence)
+    assert {row['name']: row['passed'] for row in got} == {'unit': 17, 'integration': 8, 'e2e': 6}
+    rows[0]['passed'] = True
+    evidence.write_text(json.dumps({'commands': rows}))
+    with pytest.raises(ValueError, match='count'):
+        builder.load_test_evidence(evidence)
+
+
+def test_metadata_rejects_changed_or_failed_execution_evidence(tmp_path):
+    builder = module('perf_metadata_reject', 'tools/build_handoff.py')
+    log = tmp_path / 'test.log'; log.write_text('failed test')
+    rows = [{'name': name, 'argv': ['python', '-m', 'pytest'], 'cwd': str(tmp_path),
+             'utc': '2026-10-31T00:00:00Z', 'exit_code': 1, 'passed': 0, 'failed': 1,
+             'skipped': 0, 'log': str(log), 'log_sha256': builder.sha(log)}
+            for name in ['unit', 'integration', 'e2e']]
+    evidence = tmp_path / 'evidence.json'; evidence.write_text(json.dumps({'commands': rows}))
+    with pytest.raises(ValueError, match='failed|exit'):
+        builder.load_test_evidence(evidence)
+    for row in rows:
+        row.update(exit_code=0, failed=0, passed=1)
+    log.write_text('changed after execution')
+    evidence.write_text(json.dumps({'commands': rows}))
+    with pytest.raises(ValueError, match='hash'):
+        builder.load_test_evidence(evidence)
