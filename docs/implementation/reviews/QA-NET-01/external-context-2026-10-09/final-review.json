  "findings": [
    {
      "id": "PH111-R1",
      "severity": "P2",
      "title": "MCP InitializeResult 必填 serverInfo 未校验即推进收费协议阶段",
      "file": "runs/n111a/qa/src/providers/external_search_provider.py",
      "line_start": 598,
      "line_end": 609,
      "source_sha256": "b6caee938729325c197e5994c33a48a5899a580891c67669be0a23807b5669b2",
      "reproduction": "实际 _parse_mcp_control initialize 对关联 JSON-RPC 200 result 仅保留 protocolVersion/capabilities.tools；缺 serverInfo 或 serverInfo={name:17,version:null} 均返回有效 control。_perform 将其 parse_status=ok，_settle_mcp_controls 继续 notification/discovery/search。独立 guarded inline 反例 exit0、两种畸形均 accepted=true。",
      "impact": "未完成有效 MCP 初始化仍被持久表示为成功协商并准许后续收费请求；此 finding 不表示任意主机派发或账本重复计费。",
      "minimum_fix": "在返回 initialize control 前验证 serverInfo 对象及必填 name/version 的 string 类型；无需持久化原对象、增加通用 MCP 客户端或另建账本。补缺失/非对象/name/version 非字符串负例和两种已支持协议的有效控制正例。",
      "status": "open",
      "reference": "https://raw.githubusercontent.com/modelcontextprotocol/specification/main/schema/2025-03-26/schema.ts"
    },
    {
      "id": "PH111-R2",
      "severity": "P2",
      "title": "实际上下文/use owner 允许跨 generation 复用外部检索",
      "file": "runs/n111a/qa/src/utils/quick_scan_external_context.py",
      "line_start": 246,
      "line_end": 252,
      "related_location": "runs/n111a/qa/src/utils/quick_scan_external_journal.py:1000",
      "source_sha256": "37dc9f98de2dc532292024c9b1d3fa0d5507efa7f3685cbef4abcf149d26191e",
      "related_source_sha256": "389add0fd0cc6f4af42237cc6150e5dbb7c048af4fc7dddd038688fdfae5d1d0",
      "reproduction": "实际 _external_answer_fixture 先完成 generation1 HTTP检索与Q09结算；_created(store,generation=2) 创建同发行人新 work/lease，再显式传入原 operation IDs 到 build_external_question_context/_send_external_answer。结果旧 operation_used=true、新 work_bound=true、search_http_count=1、model_http_count=1、proof_present=true。",
      "impact": "正式 coordinator cache key 包含 generation，CLI 正常路径未见跨代次重用；但实际绑定/使用证据 owner 缺少同generation要求，可让上一轮检索通过新轮 context/use proof。真实派发证明与代次冻结承诺不一致。",
      "minimum_fix": "build_external_question_context 逐检索比较原 work_fingerprint.generation 与当前 item.generation；read_use 回读逐检索比较当前 work.generation，防止持久 proof 回读绕过。保留同generation跨题及新lease的已结算证据复用；仅负例不修改旧receipt/hash。",
      "status": "open"
    }
  ],
