+
+def first_source(corpus):
+    return json.loads((corpus/'sources.json').read_bytes())['rows'][0]
+
+def test_sources_keep_reported_midnight_separate_from_actual_reads():
+    rows=audit._read_rows(CONTENT,'sources.json')
+    assert len(rows)==51 and all(r['reported_read_at_utc']=='2026-10-30T00:00:00Z' for r in rows)
+    assert all(r['historical_read_at_utc'] is None for r in rows)
+    assert all(r['read_at_utc'] is None or r['read_at_utc']!='2026-10-30T00:00:00Z' for r in rows)
+
+def test_new_wire_versions_cannot_be_mixed(corpus):
+    edit(corpus/'sources.json',lambda d:d.__setitem__('protocol','iqs.live_answer_content_audit/1.0.0'))
+    with pytest.raises(audit.AuditIntegrityError):check(corpus)
+
+def test_source_publication_cannot_be_forged_before_cutoff_with_a_flag(corpus):
+    edit(corpus/'sources.json',lambda d:d['rows'][0].__setitem__('published_at','2030-01-01'))
+    with pytest.raises(audit.AuditIntegrityError):check(corpus)
+
+def test_source_checked_claims_cannot_name_foreign_unlisted_claims(corpus):
+    edit(corpus/'sources.json',lambda d:d['rows'][0]['verified_claims'].append('FOREIGN-C1'))
+    with pytest.raises(audit.AuditIntegrityError):check(corpus)
+
+def test_summary_counts_must_match_final_source_rows(corpus):
+    edit(corpus/'audit-summary.json',lambda d:d['rows']['source_mode_counts'].__setitem__('direct_page',999))
+    with pytest.raises(audit.AuditIntegrityError):check(corpus)
+
+@pytest.mark.parametrize('field,value',[
+ ('verification_mode','invented'),('verification_tool_refs',[]),('read_at_utc','2026-10-30T00:00:00Z'),
+ ('historical_read_at_utc','2026-10-31T00:00:00Z'),('historical_snapshot_verified',True),
