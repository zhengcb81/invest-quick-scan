+def test_complete_legacy_wire_still_loads_without_becoming_current_proof(corpus):
+    import copy
+    from audit.build_content import build_coverage
+    samples=audit.load_private_samples(PRIVATE,EXPECTED_PRIVATE_SHA256)
+    docs={n:json.loads((corpus/n).read_bytes()) for n in ['claims.json','sources.json','sample-verdicts.json','coverage.json','audit-summary.json']}
+    claims=docs['claims.json']['rows'];sources=docs['sources.json']['rows'];verdicts=docs['sample-verdicts.json']['rows']
+    for c in claims:
+        c['verdict']=c['reported_verdict']
+        if 'reported_proposition' in c:c['proposition']=c['reported_proposition']
+        for key in ['reported_verdict','reported_proposition','verification_basis','verification_source_refs','contextual_findings','verification_scope']:c.pop(key,None)
+    docs['sources.json']['rows']=[s['reported_source'] for s in sources]
+    for v in verdicts:
+        for field in ['audit_status','reasoning_status','date_semantics_status']:v[field]=v.pop('reported_'+field)
+    docs['coverage.json']['rows']=build_coverage(samples,claims,verdicts)
+    for name,d in docs.items():
+        d['protocol']='iqs.live_answer_content_audit/1.0.0'
+        (corpus/name).write_text(json.dumps(d,ensure_ascii=False),encoding='utf-8')
+    result=check(corpus)
+    assert result['protocol'].endswith('/1.0.0')
+    assert result['rows']['accuracy_statement'] is None
