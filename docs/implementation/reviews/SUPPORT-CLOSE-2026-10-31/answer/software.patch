+"""Versioned source re-verification; preserves received assertions as history.
+
+No network, clock renewal, score computation or claim entailment by keywords.
+The explicit human audit decisions are inputs; this module validates linkage.
+"""
+from __future__ import annotations
+
+import copy
+from collections import Counter
+from datetime import datetime, timezone
+from urllib.parse import urlsplit
+
+PROTOCOL = 'iqs.live_answer_content_audit/1.1.0'
+MODES = {'direct_page', 'search_digest', 'unreadable', 'unverified'}
+BASES = {'direct_source', 'original_answer_only', 'not_assessable'}
+
+
+def fail(reason):
+    from . import AuditIntegrityError
+    raise AuditIntegrityError(reason)
+
+
+def utc(value):
+    if not isinstance(value, str) or not value.endswith(('Z', '+00:00')):
+        fail('provenance timestamp must be explicit UTC')
+    try:
+        return datetime.fromisoformat(value[:-1] + '+00:00' if value.endswith('Z') else value)
+    except ValueError:
+        fail('provenance timestamp invalid')
+
+
+def public_url(value):
+    if not isinstance(value, str) or any(c.isspace() for c in value):
+        return False
+    try:
+        parsed = urlsplit(value)
+        return bool(parsed.scheme in {'http', 'https'} and parsed.hostname
+                    and not parsed.username and not parsed.password)
+    except ValueError:
+        return False
+
+
+def revise(source_rows, claims, verdicts, revision):
+    """Produce 1.1 records without changing frozen observations or old outputs."""
+    if revision.get('protocol') != 'iqs.source_reverification/1.0.0':
+        fail('unsupported source re-verification protocol')
+    from . import INPUT_LOCK_SHA256
+    if revision.get('input_lock_sha256') != INPUT_LOCK_SHA256:
+        fail('source re-verification input lock mismatch')
+    checks = revision.get('sources', [])
+    decisions = revision.get('claim_decisions', [])
+    by_source = {s['source_id']: s for s in checks}
+    by_claim = {c['claim_id']: c for c in decisions}
+    if len(checks) != len(by_source) or set(by_source) != {s['source_id'] for s in source_rows}:
+        fail('re-verification must explicitly cover each source once')
+    if len(decisions) != len(by_claim) or set(by_claim) != {c['claim_id'] for c in claims}:
+        fail('re-verification must explicitly cover each claim once')
+    sources = copy.deepcopy(source_rows)
+    for source in sources:
+        check = by_source[source['source_id']]
+        mode = check.get('verification_mode')
+        if mode not in MODES:
+            fail('unknown verification mode')
+        source['reported_source'] = copy.deepcopy(source)
+        source['original_url'] = source['url']
+        source['reported_read_at_utc'] = source['read_at_utc']
+        source['historical_read_at_utc'] = None
+        source['historical_read_at_precision'] = 'unknown'
+        source['historical_snapshot_verified'] = False
+        source['verification_mode'] = mode
+        source['verification_tool_refs'] = check.get('tool_refs', [])
+        source['verified_claims'] = check.get('checked_claim_ids', [])
+        source['supported_claims'] = check.get('supported_claim_ids', [])
+        source['partially_supported_claims'] = check.get('partially_supported_claim_ids', [])
+        source['contradicted_claims'] = check.get('contradicted_claim_ids', [])
+        source['read_window_utc'] = check.get('read_window_utc')
+        source['recorded_after_builtin_read_at_utc'] = check.get('recorded_after_builtin_read_at_utc')
+        source['read_timing_basis'] = check.get('read_timing_basis', 'Exact historical reading time unavailable; current record does not renew an observation.')
+        source['read_at_utc'] = None
+        source['read_at_precision'] = 'unknown'
+        source['url'] = check.get('verified_url') or (source['url'] if public_url(source['url']) else None)
+        source['final_url'] = check.get('final_url') if mode == 'direct_page' else None
+        source['locator'] = check.get('locator')
+        source['published_at'] = check.get('published_at')
+        source['published_at_precision'] = check.get('published_at_precision', 'unknown')
+        source['cutoff_availability_basis'] = check.get('cutoff_availability_basis', 'not_established')
+        source['cutoff_availability'] = check.get('cutoff_availability', 'unknown')
+        source['bounded_excerpt'] = check.get('bounded_excerpt', '')
+        source['excerpt_kind'] = 'reviewer_paraphrase'
+        source['supports'] = check.get('supports', '')
+        source['does_not_support'] = check.get('does_not_support') or 'Does not establish historical retrieval, company score or financial qualification.'
+        source['fetch_status'] = check.get('fetch_status', 'ok' if mode == 'direct_page' else 'not_attempted')
+        source['publisher'] = check.get('publisher') or source['publisher']
+        source['source_kind'] = check.get('source_kind') or source['source_kind']
+        if mode in {'direct_page', 'search_digest'}:
+            window = source['read_window_utc']
+            if window is not None:
+                if not isinstance(window, dict) or utc(window['end']) < utc(window['start']):
+                    fail('read window inverted/invalid')
+                source['read_at_utc'] = window['end']
+                source['read_at_precision'] = 'window_end'
+        validate_source(source)
+    by_verified_source = {s['source_id']: s for s in sources}
+    new_claims = copy.deepcopy(claims)
+    for claim in new_claims:
+        decision = by_claim[claim['claim_id']]
+        claim['reported_verdict'] = claim['verdict']
+        claim['verification_basis'] = decision.get('verification_basis')
+        claim['verification_source_refs'] = decision.get('source_refs', [])
+        claim['verdict'] = decision['verdict']
+        claim['verification_note'] = decision['note']
+        claim['open_evidence_gaps'] = decision.get('open_evidence_gaps', [])
+        claim['contextual_findings'] = decision.get('contextual_findings', [])
+        claim['verification_scope'] = 'Current source contents; historical retrieval and cutoff availability remain separately qualified.'
+        if decision.get('corrected_proposition'):
+            claim['reported_proposition'] = claim['proposition']
+            claim['proposition'] = decision['corrected_proposition']
+        validate_claim(claim, by_verified_source)
+    new_verdicts = copy.deepcopy(verdicts)
+    for row in new_verdicts:
+        group = [c for c in new_claims if c['sample_id'] == row['sample_id']]
+        counts = Counter(c['verdict'] for c in group)
+        row['reported_audit_status'] = row['audit_status']
+        row['reported_reasoning_status'] = row['reasoning_status']
+        row['reported_date_semantics_status'] = row['date_semantics_status']
+        if counts['contradicted']:
+            row['audit_status'] = 'contradicted'
+        elif counts['not_assessable']:
+            row['audit_status'] = 'partially_supported' if counts['supported'] or counts['partially_supported'] else 'not_assessable'
+        elif counts['partially_supported']:
+            row['audit_status'] = 'partially_supported'
+        else:
+            row['audit_status'] = 'supported'
+        if row['original_status'] == 'scored':
+            row['reasoning_status'] = 'unsupported' if counts['contradicted'] else 'not_assessable' if counts['not_assessable'] else row['reasoning_status']
+        if any(c['contextual_findings'] for c in group) and row['original_status']=='scored':
+            row['reasoning_status']='unsupported'
+        if any(sources_ref['cutoff_availability']=='unknown' for c in group for sources_ref in [by_verified_source[ref] for ref in c['verification_source_refs']]):
+            row['date_semantics_status']='ambiguous'
+        row['rationale'] = '1.1 re-verification: ' + '; '.join(c['claim_id'] + ': ' + c['verification_note']+' '.join(c['contextual_findings']) for c in group)
+        row['source_refs'] = sorted({s for c in group for s in c['verification_source_refs']})
+        row['open_evidence_gaps'] = sorted({g for c in group for g in c['open_evidence_gaps']})
+    return sources, new_claims, new_verdicts
+
+
+def validate_source(source):
+    mode = source.get('verification_mode')
+    if mode not in MODES:
+        fail('unknown verification mode')
+    for key in ('verification_tool_refs','verified_claims','supported_claims','partially_supported_claims','contradicted_claims'):
+        values=source.get(key)
+        if not isinstance(values,list) or any(not isinstance(x,str) or not x for x in values) or len(values)!=len(set(values)):
+            fail('source provenance list invalid: '+key)
+    if not set(source['supported_claims']+source['partially_supported_claims']+source['contradicted_claims']).issubset(source['verified_claims']):
+        fail('source assessment exceeds checked claims')
+    if source.get('historical_snapshot_verified') is not False or source.get('historical_read_at_utc') is not None:
+        fail('new read must not impersonate historical capture')
+    if source.get('url') is not None and not public_url(source['url']):
+        fail('source URL is not an exact public resource')
+    if mode == 'direct_page':
+        if not public_url(source.get('final_url')) or not source.get('locator') or source.get('fetch_status') != 'ok':
+            fail('direct read lacks exact final URL/location/success')
+    if mode in {'direct_page', 'search_digest'}:
+        window=source.get('read_window_utc')
+        if not source.get('verification_tool_refs'):
+            fail('successful read needs actual tool provenance')
+        if window is None:
+            utc(source.get('recorded_after_builtin_read_at_utc'))
+            if source.get('read_at_utc') is not None or source.get('read_at_precision')!='unknown':
+                fail('recording time cannot replace unknown exact read time')
+        elif (not isinstance(window,dict) or utc(window['start']) > utc(window['end'])
+              or source.get('read_at_utc') != window['end'] or source.get('read_at_precision') != 'window_end'):
+            fail('source read-time provenance mismatch')
+        elif source.get('recorded_after_builtin_read_at_utc') is not None and utc(source['recorded_after_builtin_read_at_utc'])<utc(window['end']):
+            fail('recorded-after time precedes completed read window')
+    elif source.get('read_at_utc') is not None or source.get('read_at_precision') != 'unknown':
+        fail('unread source cannot receive a verification time')
+
+
+def validate_claim(claim, sources):
+    basis = claim.get('verification_basis')
+    refs = claim.get('verification_source_refs')
+    if claim.get('verdict') not in {'supported','partially_supported','contradicted','not_assessable'}:
+        fail('unknown claim verdict')
+    if basis not in BASES or not isinstance(refs, list) or len(refs) != len(set(refs)):
+        fail('claim verification basis/references invalid')
+    if any(ref not in sources for ref in refs):
+        fail('verification references unknown source')
+    if basis == 'original_answer_only':
+        if claim['claim_type'] not in {'absence_or_coverage', 'judgment'} or refs:
+            fail('original-answer-only cannot verify external financial facts')
+    elif claim['verdict'] != 'not_assessable':
+        if basis != 'direct_source' or not refs:
+            fail('assessable external claim needs explicit direct verification')
+        for ref in refs:
+            source=sources[ref]
+            if source['verification_mode'] != 'direct_page' or claim['claim_id'] not in source['verified_claims']:
+                fail('digest/unread source or unchecked claim cannot support verdict')
+        required='supported_claims' if claim['verdict']=='supported' else 'contradicted_claims' if claim['verdict']=='contradicted' else None
+        if required and not any(claim['claim_id'] in sources[r][required] for r in refs):
+            fail('claim verdict exceeds explicit direct source assessment')
+    if basis == 'not_assessable' and claim['verdict'] != 'not_assessable':
+        fail('unverified proposition must remain not_assessable')
