+"""Legacy writers must refuse before touching metadata or truncating a manifest."""
+import json,hashlib,subprocess,sys
+from pathlib import Path
+import pytest
+LAB=Path(__file__).resolve().parents[2]
+
+@pytest.mark.parametrize('tool',['build_handoff.py','build_payload_manifest.py'])
+def test_legacy_writer_refuses_without_any_write(tool,tmp_path):
+    protected=[LAB/'docs/payload-manifest.json',*(LAB/'docs/handoff').rglob('*')]
+    before={str(p):hashlib.sha256(p.read_bytes()).hexdigest() for p in protected if p.is_file()}
+    target=tmp_path/'should-not-be-created.json'
+    result=subprocess.run([sys.executable,'-B',str(LAB/'tools'/tool),'--out',str(target)],cwd=tmp_path,
+        capture_output=True,text=True,encoding='utf-8',timeout=20)
+    assert result.returncode==2
+    assert json.loads(result.stdout)['error_code']=='legacy_generator_retired'
+    assert not target.exists()
+    assert before=={str(p):hashlib.sha256(p.read_bytes()).hexdigest() for p in protected if p.is_file()}
