+"""Native delegation-store lifecycle with original synthetic preview boundary.
+
+This is unit coverage of original grant/revocation storage and rechecks. The
+frozen upstream helper stubs its preview contract; this is intentionally NOT a
+claim of public-CLI/real-owner permission authorization or financial truth.
+"""
+import hashlib
+import importlib.util
+import inspect
+from pathlib import Path
+import sys
+import pytest
+
+LAB=Path(__file__).resolve().parents[2]
+sys.path.insert(0,str(LAB/'vendor_upstream/stockwiki'))
+
+
+@pytest.mark.parametrize('cache_count',[0,36])
+def test_native_delegation_revoke_survives_reopen_and_cached_scope(tmp_path,cache_count):
+    # Candidate changes only IQS owner/service. Grant storage stays the exact
+    # immutable upstream file for BOTH variants, not a second grant engine.
+    from stockwiki.quick_scan_refresh_delegation import DelegatedApprovalService
+    source=LAB/'vendor_upstream/stockwiki/stockwiki/quick_scan_refresh_delegation.py'
+    assert hashlib.sha256(Path(inspect.getfile(DelegatedApprovalService)).read_bytes()).digest()==hashlib.sha256(source.read_bytes()).digest()
+    fixture_path=LAB/'vendor_upstream/stockwiki/tests/test_quick_scan_refresh_delegation.py'
+    spec=importlib.util.spec_from_file_location('original_delegation_fixture',fixture_path)
+    helper=importlib.util.module_from_spec(spec);spec.loader.exec_module(helper)
+    service,record,_,_,_,now=helper.prepared(tmp_path,cache_count=cache_count)
+    grant_id=service.install()['grant_id']
+    confirmed=service.confirm(record['preview']['preview_id'],grant_id,'synthetic-only-action')
+    prior=service.inspect_confirmation(confirmed['confirmation_id'],admission_mode='current_permissions')
+    assert prior['confirmation']['delegation']['grant_id']==grant_id
+    confirmation_path=service.confirmations.directory/(confirmed['confirmation_id']+'.json')
+    original_confirmation=confirmation_path.read_bytes()
+    service.revoke(grant_id)
+    reopened=DelegatedApprovalService(paths=service.paths,previews=service.previews,preview_service=service.preview_service,clock=lambda:now.value)
+    assert reopened.revocations.load(grant_id)['grant_id']==grant_id
+    with pytest.raises(ValueError,match='delegation_revoked'):
+        reopened.inspect_confirmation(confirmed['confirmation_id'],admission_mode='current_permissions')
+    with pytest.raises(ValueError):reopened.confirm(record['preview']['preview_id'],grant_id,'synthetic-only-action')
+    with pytest.raises(ValueError):reopened.install()
+    assert confirmation_path.read_bytes()==original_confirmation
