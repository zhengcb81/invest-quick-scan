@@ -0,0 +1,74 @@
+"""Publisher guard unit: original owner permission engine, synthetic carrier.
+
+Original WorkDecisionOwnerService creates a genuine local rc1 fixture record.
+Its preview/inspection/confirmation input boundary is the upstream explicitly
+synthetic helper. No published native checkpoint, outbox or real owner consent
+is manufactured; a tiny separate SQLite carrier isolates require_publisher.
+"""
+from dataclasses import asdict
+from datetime import datetime,timezone
+import importlib.util
+import json
+from pathlib import Path
+import sqlite3
+import sys
+import pytest
+
+LAB=Path(__file__).resolve().parents[2]
+for root in [LAB/'vendor_upstream/stockwiki',LAB/'vendor_upstream/stockqa']:
+    sys.path.insert(0,str(root))
+
+
+@pytest.mark.parametrize('entry',['require_publisher','seal_result_delivery'])
+def test_original_publisher_gate_rechecks_source_permission_before_outbox(tmp_path,entry):
+    from src.utils.quick_scan_known_outcome_journal import OwnerWorkDecisionAuthority,OwnerWorkDecisionGrant,_authorize
+    from src.utils.quick_scan_saved_research_publication import require_publisher
+    from src.utils.quick_scan_delivery_seal import seal_result_delivery
+    fixture_path=LAB/'vendor_upstream/stockwiki/tests/test_quick_scan_work_decision_owner.py'
+    spec=importlib.util.spec_from_file_location('publisher_owner_fixture',fixture_path)
+    helper=importlib.util.module_from_spec(spec);spec.loader.exec_module(helper)
+    f=helper.fixture(tmp_path/'source-owner')
+    _,confirmed=helper.confirm(f)
+    request=f.outer['decision_request']
+    class UnitDeploymentAuthority(OwnerWorkDecisionAuthority):
+        calls=0
+        def authorize(self,value):
+            self.calls+=1
+            # This actual original method rereads current permission; its
+            # previous successful result is not returned or cached here.
+            inspected=f.owner.inspect(confirmed['confirmation_id'],admission_mode='current_permissions')
+            c=inspected['confirmation']
+            assert value==inspected['request']['decision_request']
+            return OwnerWorkDecisionGrant(owner_store_id=c['owner_store_id'],principal_id=c['owner_principal'],
+                confirmation_id=c['confirmation_id'],action_id=c['action_id'],request_sha256=c['request_sha256'],confirmed_at=c['confirmed_at'])
+    authority=UnitDeploymentAuthority()
+    now=datetime(2026,10,31,tzinfo=timezone.utc).timestamp()
+    grant=_authorize(authority,request,now)
+    carrier=tmp_path/'synthetic-schema3-carrier.sqlite'
+    with sqlite3.connect(carrier) as con:
+        con.execute('CREATE TABLE answer_checkpoint(work_item_id TEXT PRIMARY KEY,checkpoint_schema_version INTEGER,payload_json TEXT)')
+        con.execute('INSERT INTO answer_checkpoint VALUES (?,?,?)',('WORK_SYNTHETIC',3,json.dumps({'publication':{'request':request,'grant':grant}})))
+    class CarrierStore:
+        outbox_reads=0
+        _now=staticmethod(lambda:now)
+        def _connect(self):
+            c=sqlite3.connect(carrier);c.row_factory=sqlite3.Row;return c
+        def get_answer_checkpoint(self,*args,**kwargs):return {'checkpoint_schema_version':3}
+        def get_result_delivery(self,*args,**kwargs):
+            self.outbox_reads+=1
+            raise AssertionError('revoked publisher must fail before accessing the outbox')
+    store=CarrierStore()
+    with store._connect() as con:
+        assert require_publisher(store,con,'WORK_SYNTHETIC',authority)==request
+    before=carrier.read_bytes()
+    # Original permission engine rejects a previously confirmed action after
+    # its consumer is removed. No synthetic revoke boolean in the adapter.
+    f.policy['allowed_consumer_ids']=[]
+    with pytest.raises(ValueError,match='permission_denied'):
+        if entry=='require_publisher':
+            with store._connect() as con:require_publisher(store,con,'WORK_SYNTHETIC',authority)
+        else:
+            seal_result_delivery(store,'WORK_SYNTHETIC',authority=None,publisher_authority=authority)
+    assert store.outbox_reads==0
+    assert authority.calls>=3
+    assert carrier.read_bytes()==before
