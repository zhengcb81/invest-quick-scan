{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invest-quick-scan.local/schemas/prestudy-archive-index-1.0.0.schema.json",
  "title": "Read-only consumer prestudy archive index",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "entries"],
  "properties": {
    "format_version": {"const": "1.0.0"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "package_id", "report_path", "report_sha256", "handoff_path",
          "handoff_sha256", "observed_at_utc", "accepted_at_utc",
          "input_commits", "report_status", "implementation_status",
          "dependency_gaps"
        ],
        "properties": {
          "package_id": {"enum": ["TH-01", "IN-02"]},
          "report_path": {"type": "string", "pattern": "^(TH-01|IN-02)-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9a-f]{12}\\.md$"},
          "report_sha256": {"$ref": "#/$defs/sha256"},
          "handoff_path": {"type": "string", "pattern": "^(TH-01|IN-02)-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9a-f]{12}\\.handoff\\.json$"},
          "handoff_sha256": {"$ref": "#/$defs/sha256"},
          "observed_at_utc": {"type": "string", "format": "date-time"},
          "accepted_at_utc": {"type": "string", "format": "date-time"},
          "input_commits": {
            "type": "object",
            "additionalProperties": false,
            "required": ["local_skills", "stockwiki", "iqs"],
            "properties": {
              "local_skills": {"$ref": "#/$defs/commit"},
              "stockwiki": {"$ref": "#/$defs/commit"},
              "iqs": {"$ref": "#/$defs/commit"}
            }
          },
          "report_status": {"enum": ["prestudy_complete", "partial", "blocked"]},
          "implementation_status": {"const": "not_started"},
          "dependency_gaps": {
            "type": "array", "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"}
  }
}
