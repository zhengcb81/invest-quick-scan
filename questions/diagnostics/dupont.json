      "dimension": "financial",
      "priority": 1,
      "framework": "dupont",
      "factor": "roe",
      "aggregation": "diagnostic",
      "question": "杜邦总览：公司的ROE水平、来源与可持续性如何？",
      "evidence": [
        "同口径净利润与平均权益",
        "三至五年ROE",
        "同业与周期位置"
      ],
      "anchors": {
        "1": "回报长期不足或主要靠会计及杠杆假象",
        "5": "ROE合理但来源质量和持续性普通",
        "10": "稳健经营因素支撑持续良好ROE而非激进杠杆"
      },
      "metric_id": "score.dupont_01",
      "construct_id": null,
      "comparison_role": "diagnostic",
      "rubric_version": "1.0.0",
      "scope": "entity"
    },
    {
