      "dimension": "business",
      "priority": 1,
      "framework": "dupont",
      "factor": "net_margin",
      "aggregation": "diagnostic",
      "question": "杜邦三因素·净利率：每单位收入转为真实净利润的能力如何？",
      "evidence": [
        "净利润/收入",
        "一次性损益",
        "产品组合",
        "同业净利率"
      ],
      "anchors": {
        "1": "净利率持续恶化或主要靠非经常项目",
        "5": "正常化净利率接近合理同业",
        "10": "同口径正常化净利率稳健优秀且现金支持"
      },
      "metric_id": "score.dupont_02",
      "construct_id": null,
      "comparison_role": "diagnostic",
      "rubric_version": "1.0.0",
      "scope": "entity"
    },
