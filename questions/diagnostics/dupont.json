      "evidence": [
        "EBIT/收入",
        "毛利",
        "销售研发管理费用",
        "经营与非经营调整"
      ],
      "anchors": {
        "1": "核心经营亏损或持续恶化",
        "5": "正常化经营盈利符合行业平均",
        "10": "核心经营利润率稳健且改善源于真实定价或效率"
      },
      "metric_id": "score.dupont_05",
      "construct_id": null,
      "comparison_role": "diagnostic",
      "rubric_version": "1.0.0",
      "scope": "entity"
    },
    {
      "id": "DUPONT_06",
