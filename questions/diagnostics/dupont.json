      "factor": "interest_burden",
      "aggregation": "diagnostic",
      "question": "杜邦五因素·利息负担系数：融资费用侵蚀利润的程度是否可控？",
      "evidence": [
        "EBT/EBIT",
        "净利息",
        "利息覆盖",
        "再融资成本"
      ],
      "anchors": {
        "1": "融资吞噬经营成果且压力下不可覆盖",
        "5": "利息消耗可承受但存在再定价压力",
        "10": "融资负担适当且压力下可覆盖，接近1不是唯一依据"
      },
      "metric_id": "score.dupont_06",
      "construct_id": null,
      "comparison_role": "diagnostic",
      "rubric_version": "1.0.0",
      "scope": "entity"
