{
  "version": "3.0.0",
  "module_id": "dupont",
  "kind": "diagnostics",
  "name": "杜邦回报来源诊断",
  "applies_when": "ROE变动或质量无法由核心题解释时选用；仅在因子具经济含义时评分，不进入汇总。",
