    {
      "id": "DUPONT_07",
      "dimension": "financial",
      "priority": 1,
      "framework": "dupont",
      "factor": "tax_burden",
      "aggregation": "diagnostic",
      "question": "杜邦五因素·税负系数：税后利润保留比例是否合理且可持续？",
      "evidence": [
        "净利润/EBT",
        "实际与法定税率",
        "递延税",
        "优惠到期"
