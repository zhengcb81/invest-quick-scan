    "schemas/observation.schema.json": {
      "$id": "urn:iqs:observation:1",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "schema_version": {
                "const": "1.1.0"
              }
            },
            "required": [
              "schema_version"
            ]
          },
          "then": {
            "required": [
              "module_package_id",
              "module_release_id",
              "question_definition_sha256",
              "question_semantic_sha256",
              "cycle_sensitive"
            ]
          }
        }
      ],
      "properties": {
        "answer": {
          "$ref": "urn:iqs:answer-content:1"
        },
        "cohort": {
          "additionalProperties": false,
          "properties": {
            "company_type": {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            "industries": {
              "items": {
                "maxLength": 100,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 2,
              "type": "array"
            },
            "stage": {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            "subtype": {
              "anyOf": [
                {
                  "maxLength": 100,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "company_type",
            "industries",
            "stage",
            "subtype"
          ],
          "type": "object"
        },
        "comparison_group_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "construct_id": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "cycle_sensitive": {
          "type": "boolean"
        },
        "entity_id": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        },
        "evidence_review_status": {
          "enum": [
            "unreviewed",
            "reviewed"
          ]
        },
        "execution": {
          "additionalProperties": false,
          "properties": {
            "answered_at": {
              "format": "date-time",
              "type": "string"
            },
            "attempt_id": {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            "model_requested": {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            "model_resolved": {
              "anyOf": [
                {
                  "maxLength": 160,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "model_revision": {
              "anyOf": [
                {
                  "maxLength": 160,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "prompt_sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "provider": {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            "request_id": {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            "search_receipt_id": {
              "anyOf": [
                {
                  "maxLength": 160,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "search_status": {
              "enum": [
                "executed",
                "unavailable",
                "unverified"
              ]
            },
            "started_at": {
              "format": "date-time",
              "type": "string"
            }
          },
          "required": [
            "provider",
            "model_requested",
            "model_resolved",
            "model_revision",
            "request_id",
            "attempt_id",
            "started_at",
            "answered_at",
            "search_status",
            "search_receipt_id",
            "prompt_sha256"
          ],
          "type": "object"
        },
        "field_id": {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        "information_cutoff": {
          "format": "date",
          "type": "string"
        },
        "inputset_id": {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        "method_id": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        "module_package_id": {
          "pattern": "^pkg_[a-f0-9]{64}$",
          "type": "string"
        },
        "module_release_id": {
          "pattern": "^modrel_[a-f0-9]{64}$",
          "type": "string"
        },
        "observation_id": {
          "pattern": "^obs_[a-f0-9]{64}$",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "type": "string"
        },
        "question_definition_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "question_id": {
          "maxLength": 80,
          "minLength": 1,
          "type": "string"
        },
        "question_semantic_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "question_version": {
          "maxLength": 40,
          "minLength": 1,
          "type": "string"
        },
        "run_id": {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        "scan_id": {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        "schema_version": {
          "enum": [
            "1.0.0",
            "1.1.0"
          ]
        },
        "scope": {
          "enum": [
            "entity",
            "security",
            "segment"
          ]
        },
        "security_id": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "segment_id": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "task_mode": {
          "enum": [
            "primary",
            "comparison"
          ]
        },
        "template_version": {
          "maxLength": 40,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "observation_id",
        "entity_id",
        "security_id",
        "segment_id",
        "field_id",
        "construct_id",
        "question_id",
        "question_version",
        "template_version",
        "method_id",
        "scope",
        "cohort",
        "information_cutoff",
        "run_id",
        "scan_id",
        "inputset_id",
        "task_mode",
        "comparison_group_id",
        "observed_at",
        "execution",
        "answer",
        "evidence_review_status"
      ],
      "type": "object"
    },
    "schemas/quick_scan/metric.schema.json": {
      "$id": "https://invest-quick-scan.local/schemas/quick_scan/metric.schema.json",
      "$schema": "http://json-schema.org/draft-07/schema#",
      "definitions": {
        "AggregationRole": {
          "enum": [
            "quality_core",
            "growth_core",
            "valuation_core",
            "diagnostic_only"
          ],
          "type": "string"
        },
        "Cohort": {
          "enum": [
            "all",
            "operating",
            "bank",
            "insurer",
            "property_developer",
            "property_owner",
            "capital_markets",
            "holding",
            "pre_revenue",
            "cyclical"
          ],
          "type": "string"
        },
        "ComparabilityScope": {
          "enum": [
            "cross_cohort_comparable",
            "within_cohort_only",
            "non_comparable"
          ],
          "type": "string"
        },
        "MetricContractBundle": {
          "additionalProperties": false,
          "properties": {
            "contract_version": {
              "pattern": "^\\d+\\.\\d+\\.\\d+$",
              "type": "string"
            },
            "metrics": {
              "items": {
                "$ref": "#/definitions/MetricRegistryEntry"
              },
              "type": "array"
            },
            "question_mappings": {
              "items": {
                "$ref": "#/definitions/QuestionMetricMapping"
              },
              "type": "array"
            },
            "updated_at": {
              "format": "date-time",
              "type": "string"
            }
          },
          "required": [
            "contract_version",
            "updated_at",
            "metrics",
            "question_mappings"
          ],
          "type": "object"
        },
        "MetricRegistryEntry": {
          "additionalProperties": false,
          "properties": {
            "cohort": {
              "$ref": "#/definitions/Cohort"
            },
            "comparability_scope": {
              "$ref": "#/definitions/ComparabilityScope"
            },
            "critical_risk_flag": {
              "default": false,
              "type": "boolean"
            },
            "definition": {
              "minLength": 5,
              "type": "string"
            },
            "metric_id": {
              "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$",
              "type": "string"
            },
            "unit": {
              "enum": [
                "currency",
                "percent",
                "days",
                "months",
                "count",
                "currency_per_share",
                "score_1_to_10",
                "ratio"
              ],
              "type": "string"
            }
          },
          "required": [
            "metric_id",
            "unit",
            "definition",
            "cohort",
            "comparability_scope"
          ],
          "type": "object"
        },
        "QuestionMetricMapping": {
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "dimension": {
                    "enum": [
                      "recovery_watch",
                      "dupont",
                      "porter",
                      "fact"
                    ]
                  }
                },
                "required": [
                  "dimension"
                ]
              },
              "then": {
                "properties": {
                  "aggregation_role": {
                    "const": "diagnostic_only"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "aggregation_role": {
                    "const": "diagnostic_only"
                  }
                },
                "required": [
                  "aggregation_role"
                ]
              },
              "then": {
                "properties": {
                  "critical_risk": {
                    "const": false
                  }
                }
              }
            }
          ],
          "properties": {
            "aggregation_role": {
              "$ref": "#/definitions/AggregationRole"
            },
            "critical_risk": {
              "description": "若为true，得分<=3或严重证据缺口直接构成重大风险标记，不可被加权均分或OR规则掩盖（I06, SC-09）。",
              "type": "boolean"
            },
            "dimension": {
              "enum": [
                "quality",
                "growth",
                "valuation",
                "recovery_watch",
                "dupont",
                "porter",
                "fact"
              ],
              "type": "string"
            },
            "evidence_demands": {
              "additionalProperties": false,
              "properties": {
                "counter_evidence_required": {
                  "default": true,
                  "type": "boolean"
                },
                "require_durability_conditions": {
                  "default": false,
                  "type": "boolean"
                },
                "require_net_economic_effect": {
                  "default": false,
                  "type": "boolean"
                }
              },
              "type": "object"
            },
            "primary_metric_ref": {
              "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$",
              "type": [
                "string",
                "null"
              ]
            },
            "question_id": {
              "pattern": "^[A-Z0-9_]+$",
              "type": "string"
            },
            "replacement_for": {
              "description": "所替代的通用核心题目ID（例如IQS_11或IQS_16的特定行业替代）",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "question_id",
            "dimension",
            "aggregation_role",
            "critical_risk"
          ],
          "type": "object"
        }
      },
      "description": "指标映射、证据口径与可比性契约（Task C02，契约版本 1.0.0）",
      "oneOf": [
        {
          "$ref": "#/definitions/MetricRegistryEntry"
        },
        {
          "$ref": "#/definitions/QuestionMetricMapping"
        },
        {
          "$ref": "#/definitions/MetricContractBundle"
        }
      ],
      "title": "QuickScanMetricContract",
      "type": "object"
    },
    "schemas/quick_scan/score.schema.json": {
      "$id": "https://invest-quick-scan.local/schemas/quick_scan/score.schema.json",
      "$schema": "http://json-schema.org/draft-07/schema#",
      "definitions": {
        "CheckLevel": {
          "enum": [
            "unverified_model_output",
            "execution_verified",
            "screening_audited",
            "formal_research_accepted"
          ],
          "type": "string"
        },
        "ParsedAnswer": {
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "scored"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "properties": {
                  "score": {
                    "$ref": "#/definitions/ValidScore"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "enum": [
                      "unknown",
                      "insufficient_evidence",
                      "not_applicable",
                      "error"
                    ]
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "properties": {
                  "score": {
                    "type": "null"
                  }
                }
              }
            },
            {
              "else": {
                "properties": {
                  "check_level_receipt_id": {
                    "pattern": "^RCP_[A-Za-z0-9_.-]+$",
                    "type": "string"
                  }
                },
                "required": [
                  "check_level_receipt_id"
                ]
              },
              "if": {
                "properties": {
                  "check_level": {
                    "const": "unverified_model_output"
                  }
                },
                "required": [
                  "check_level"
                ]
              },
              "then": {
                "properties": {
                  "check_level_receipt_id": {
                    "type": "null"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "is_audited_na": {
                    "const": true
                  }
                },
                "required": [
                  "is_audited_na"
                ]
              },
              "then": {
                "properties": {
                  "status": {
                    "const": "not_applicable"
                  }
                }
              }
            }
          ],
          "properties": {
            "check_level": {
              "$ref": "#/definitions/CheckLevel"
            },
            "check_level_receipt_id": {
              "description": "由可信执行或审核步骤签发的回执ID。模型原始输出不得自行授予检查等级。",
              "pattern": "^RCP_[A-Za-z0-9_.-]+$",
              "type": [
                "string",
                "null"
              ]
            },
            "critical_risk_flag": {
              "default": false,
              "type": "boolean"
            },
            "description": {
              "minLength": 1,
              "type": "string"
            },
            "information_as_of": {
              "type": [
                "string",
                "null"
              ]
            },
            "is_audited_na": {
              "default": false,
              "description": "是否经人工/规则核实为合规不适用。只有经审核的N/A才可从分母排除（SC-07）。",
              "type": "boolean"
            },
            "legacy_transport_score": {
              "description": "仅供旧版StockQA外层传输兼容读取，严禁用于均分计算或白名单筛选（SC-02）。",
              "type": [
                "integer",
                "null"
              ]
            },
            "published_date": {
              "type": [
                "string",
                "null"
              ]
            },
            "question_id": {
              "pattern": "^[A-Z0-9_]+$",
              "type": "string"
            },
            "score": {
              "description": "正式得分。若status为insufficient_evidence, unknown, not_applicable或error，必须为null（SC-02）。",
              "maximum": 10,
              "minimum": 1,
              "type": [
                "integer",
                "null"
              ]
            },
            "source_urls": {
              "default": [],
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "status": {
              "$ref": "#/definitions/ScoreStatus"
            }
          },
          "required": [
            "question_id",
            "status",
            "score",
            "description",
            "check_level"
          ],
          "type": "object"
        },
        "ScoreStatus": {
          "enum": [
            "scored",
            "unknown",
            "insufficient_evidence",
            "not_applicable",
            "error"
          ],
          "type": "string"
        },
        "ValidScore": {
          "description": "仅允许1到10之间的整数。禁止0、11、浮点数、布尔值或字符串形式（I05, SC-03）。",
          "maximum": 10,
          "minimum": 1,
          "type": "integer"
        }
      },
      "description": "评分回复、置信度与可用性等级契约（Task C03，契约版本 1.0.0）",
      "oneOf": [
        {
          "$ref": "#/definitions/ParsedAnswer"
        }
      ],
      "title": "QuickScanScoreContract",
      "type": "object"
    }
  },
