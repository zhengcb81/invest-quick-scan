{
  "format_resources": {
    "questions/metric-registry.json": {
      "metrics": {
        "bank.cet1_ratio": {
          "definition": "核心一级资本/风险加权资产，注明当地监管口径",
          "unit": "percent"
        },
        "business.employees": {
          "definition": "人员数量，注明期末/平均及员工/外包范围",
          "unit": "count"
        },
        "business.segment_revenue": {
          "definition": "指定业务分部收入，说明对外与内部抵销",
          "unit": "currency"
        },
        "financial.capex": {
          "definition": "资本支出，区分维护与增长",
          "unit": "currency"
        },
        "financial.cash_runway": {
          "definition": "可用资金相对可核实消耗的期限，注明假设",
          "unit": "months"
        },
        "financial.diluted_eps": {
          "definition": "归属普通股的摊薄每股收益",
          "unit": "currency_per_share"
        },
        "financial.fcf": {
          "definition": "经营现金流减必要资本投入，列维护/增长/租赁口径",
          "unit": "currency"
        },
        "financial.net_debt": {
          "definition": "有息债务减可用现金，不套客户存款",
          "unit": "currency"
        },
        "financial.net_margin": {
          "definition": "净利润/营业收入，说明归属口径",
          "unit": "percent"
        },
        "financial.operating_margin": {
          "definition": "营业利润/营业收入，说明调整项目",
          "unit": "percent"
        },
        "financial.revenue": {
          "definition": "对外营业收入，须注明总额/净额和合并范围",
          "unit": "currency"
        },
        "financial.roe": {
          "definition": "归属普通股净利润/平均普通股权益，说明负/近零权益",
          "unit": "percent"
        },
        "financial.roic": {
          "definition": "税后经营利润/平均投入资本，说明商誉和资本调整",
          "unit": "percent"
        },
        "insurance.combined_ratio": {
          "definition": "赔付与费用占已赚保费比例，财险适用",
          "unit": "percent"
        },
        "operating.capacity_utilization": {
          "definition": "实际产出/可用产能，同口径产品与期间",
          "unit": "percent"
        },
        "operating.inventory_days": {
          "definition": "平均库存/匹配期间销货成本折算天数",
          "unit": "days"
        },
        "operating.net_revenue_retention": {
          "definition": "同一客户批次期末收入/期初收入，说明扩张/流失范围",
          "unit": "percent"
        },
        "operating.occupancy": {
          "definition": "已出租面积或可用单元占比，注明分母",
          "unit": "percent"
        },
        "operating.receivable_days": {
          "definition": "平均应收/匹配收入折算天数",
          "unit": "days"
        },
        "operating.repeat_purchase_share": {
          "definition": "期间重复采购客户数/期间采购客户数，不等同收入留存",
          "unit": "percent"
        },
        "property.affo": {
          "definition": "调整后可分配运营现金，披露调整及归属范围",
          "unit": "currency"
        },
        "relationship.ownership_share": {
          "definition": "持股占指定类别或总股本比例，注明日期",
          "unit": "percent"
        },
        "relationship.revenue_share": {
          "definition": "指定客户/产品/地区收入占明确总收入分母的比例",
          "unit": "percent"
        }
      },
      "unmapped_policy": "Only custom.* IDs allowed outside registry; show raw values, do not compute automatic differences.",
      "version": "1.0.0"
    },
    "schemas/answer-content.schema.json": {
