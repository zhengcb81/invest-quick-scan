--- iqs-agent-runtime-lab/a/tests/test_research_response_taxonomy.py
+++ iqs-agent-runtime-lab/b/tests/test_research_response_taxonomy.py
@@ -0,0 +1,20 @@
+"""The SDK validation subtype is a received rejection, not a lost transport."""
+from src.utils.quick_scan_work_transport import QuickScanWorkUncertainError
+
+def test_real_validation_subclass_is_semantic_rejection():
+    # The standalone Runtime suite deliberately uses its frozen SDK, which
+    # predates this subclass. This is a declared taxonomy shape fixture;
+    # a separate cross-repository integration check uses the real SDK class.
+    class ResearchResponseValidationError(Exception):
+        def __init__(self, failure_type, attempt_receipt, diagnostic):
+            self.failure_type = failure_type
+            self.attempt_receipt = attempt_receipt
+            self.validation_diagnostic = diagnostic
+    from iqs_agent_runtime_lab.receiptmap import classify_transport_failure
+    err=ResearchResponseValidationError('ValueError',{'http_status_code':200},{'code':'research_incomplete_output'})
+    assert classify_transport_failure(err)==('rejected','provider_response_semantic_invalid')
+
+def test_diagnostic_does_not_override_native_uncertainty():
+    from iqs_agent_runtime_lab.receiptmap import classify_transport_failure
+    err=QuickScanWorkUncertainError('physical',{'http_status_code':200,'research_validation_code':'research_incomplete_output'})
+    assert classify_transport_failure(err)==('outcome_unknown','transport_outcome_uncertain')
